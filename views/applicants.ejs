<%- include('partials/header') %>
<section class="<%=bg%> pad-4">
    <div class="container pad-4 ">
        <div class=" pad-4">
            <h4 class="ml-4 mt-4 text-light"><%= t('ServiceProvidersInterested') %>...</h4>
            <div class="row p-3">
                <%
                    
                    if(interestedPros.length > 0) interestedPros.forEach( interestedPro=>{ %>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12 custom-px">
                        <div class="text-center card-box-pro">
                            <div class="member-card pt-2 pb-2">
                                <div class="thumb-lg member-thumb mx-auto"><img src="photo/<%=interestedPro.photo %> " class="rounded-circle img-thumbnail" alt="profile-image"></div>
                                <div class="mt-2">
                                    <a href="/applicant?p=<%=interestedPro?._id%>&j=<%=requestId%>">
                                        <h6><%=interestedPro.firstName %> <%=interestedPro.lastName %> </h6>
                                    </a>
                                    <span class="text-muted "><%=interestedPro.role %>  </span>
                                    <ul class="rating " data-mdb-toggle="rating" data-mdb-readonly="true" data-mdb-value="3"> 
                                        <% let i = 0; for(i = 0; i < interestedPro.rating; i++) { %>
                                            <li class="d-inline"><b class="fa-star fa-sm rating-star-color fas "></b></li>
                                        <% } if(i < 5) while(i < 5) { %>
                                            <li class="d-inline"><b class="fa-star-o fa-sm rating-star-color fas "></b></li>
                                        <% i++; } %>
                                    </ul>
                                    <% if(interestedPro.rate) { %> <span class="text-muted "><%= t('Rate') %>: $<%=interestedPro.rate %> / <%= t('Hr') %> </span><% } %>
                                </div>
                                <ul class="social-links list-inline">
                                    <li class="list-inline-item"><a title="<%= t('Contact') %> <%=interestedPro.firstName%>" data-toggle="tooltip" data-placement="top"  class="tooltips" href="/pro-profile/<%=interestedPro._id%>" data-caption-animate="fadeInUp"><b class="fa fa-envelope-o"></b></a></li>
                                    <li class="list-inline-item"><a title="<%= t('VisitLinkedInProfile') %> <%=interestedPro.firstName%>" data-placement="top" data-toggle="tooltip" class="tooltips" href="" data-original-title="LinkedIn"><b class="fa fa-linkedin"></b></a></li>
                                    <li class="list-inline-item"><a title="<%= t('SendWhatsAppMessage') %> <%=interestedPro.firstName%>" data-placement="top" data-toggle="tooltip" href="https://wa.me/<%=interestedPro.countryCode%><%=interestedPro.phone%>" target="_blank" data-original-title="Whatsapp"><b class="fa fa-whatsapp"></b></a></li>
                                </ul>
                        
                            </div>
                        </div>
                    </div>
                <% });  %>
                </div>

            </div>
        </div>
</section>

<%- include('partials/footer') %>