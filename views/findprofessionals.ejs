<%- include('partials/header', { categories: cats }) %>
<style>

    .btn-job {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    border: 2px solid transparent;
}


.btn-primary-job-inv:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(90, 158, 47, 0.4);
    color: white;
    text-decoration: none;
}
</style>

<section class="section <%=bg%> search-pro-section">
    <div class="container">
        <div class="row mt-1">
            <div class="col-lg-12 col-12 card-margin">
                <div class="card search-form">
                    <div class="card-body search-card-body">
                        <form id="search-form">
                            <div class="row">
                                <div class="col-12 ">
                                    <div class="row no-gutters">
                                        <div class="col-lg-3 col-md-3 col-sm-12 col-12 search-in">
                                            <input type="text" class="form-control search-input-s" placeholder="<%= t('Category') %>" name="selected_category" id="selected_category" autocomplete="off" value="<%= searchParams && searchParams.selected_category ? searchParams.selected_category : '' %>" data-value="<%= searchParams && searchParams.selected_category ? searchParams.selected_category : '' %>">
                                        </div>
                                        <div class="col-lg-2 col-md-2 col-sm-12 search-in">
                                            <input type="text" class="form-control" placeholder="<%= t('Country') %>" id="country_search" name="country_search" autocomplete="off" value="<%= searchParams && searchParams.country_search ? searchParams.country_search : '' %>" data-value="<%= searchParams && searchParams.country_search ? searchParams.country_search : '' %>">
                                        </div>
                                        <div class="col-lg-2 col-md-3 col-sm-12 search-in">
                                            <input type="text" class="form-control" placeholder="<%= t('City') %>" id="city_search" name="city_search" autocomplete="off" value="<%= searchParams && searchParams.city_search ? searchParams.city_search : '' %>" data-value="<%= searchParams && searchParams.city_search ? searchParams.city_search : '' %>">
                                        </div>
                                        <div class="col-lg-4 col-md-3 col-sm-12 search-in">
                                            <input type="text" placeholder="<%= t('KeywordSearchPlaceholder') %>" class="form-control" id="search" name="search" value="<%= searchParams ? searchParams.search : '' %>">
                                        </div>
                                        <div class="col-lg-1 col-md-3 col-sm-12 p-0">
                                            <button type="button" class="search-btn" onclick="handleSearch()">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Providers Map Link -->
        <div class="row mb-3 mt-3">
            <div class="col-12 text-center">
                
                <a href="/providers-map" class="btn-job btn-primary-job-inv mb-1">
                        <b class="fa fa-map-marker mr-2"></b><%= t('ViewProvidersOnMap') || 'View Providers on Map' %>
                </a>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12">
                <div class="card card-margin">
                    <div class="card-body">
                        <div class="row search-body">
                            <div class="col-lg-12">
                                <div class="search-result">
                                    <div class="result-header">
                                        <div class="row">
                                            <div class="col-lg-6">
                                            <div class="records ml-4 text-muted" id="result-count">
                                                <% if(total > 0) { %>
                                                    Showing <%= ((currentPage - 1) * 10) + 1 %>-<%= Math.min(currentPage * 10, total) %> of <%= total %> professionals
                                                <% } else { %>
                                                    <%= t('ProfessionalsFound') %>
                                                <% } %>
                                            </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="result-actions">
                                                    <div class="result-sorting">
                                                        <!-- <span>Sort By:</span>
                                                        <select class="form-control border-0" id="exampleOption">
                                                            <option value="1">Relevance</option>
                                                            <option value="2">Names (A-Z)</option>
                                                            <option value="3">Names (Z-A)</option>
                                                        </select> -->
                                                    </div>
                                                    <div class="result-views">
                                                        <button type="button" onClick="handleSearch()" class="btn btn-soft-base btn-icon">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list">
                                                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                                                <line x1="3" y1="6" x2="3" y2="6"></line>
                                                                <line x1="3" y1="12" x2="3" y2="12"></line>
                                                                <line x1="3" y1="18" x2="3" y2="18"></line>
                                                            </svg>
                                                        </button>
                                                        <button type="button" onClick="handleSearchMD()" class="btn btn-soft-base btn-icon">
                                                            <!--a href="/find-services-md"-->
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-grid">
                                                                <rect x="3" y="3" width="7" height="7"></rect>
                                                                <rect x="14" y="3" width="7" height="7"></rect>
                                                                <rect x="14" y="14" width="7" height="7"></rect>
                                                                <rect x="3" y="14" width="7" height="7"></rect>
                                                            </svg><!--/a-->
                                                        </button>
                                                        <a href="/providers-map" class="btn btn-soft-base btn-icon" title="<%= t('ViewProvidersOnMap') || 'View Providers on Map' %>">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                                                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="result-body">
                                        <div class="table-responsive">
                                            <table class="table widget-26">
                                                <tbody id="professionals-box">
                                                </tbody>
                                                
                                            </table>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% if(pages > 1) { %>
                            <nav class="d-flex justify-content-center" id="paging">
                            <ul class="pagination pagination-base pagination-boxed pagination-square mb-0">
                            <li class="page-item page-link no-border"  onclick="prevPage(<%=pages%>)">
                            <span aria-hidden="true">«</span>
                            </li>
                            <li class="page-item active" id="1" onClick="setPage('<%=pages%>', 1)"><span class="page-link no-border">1</span></li>
                                <% for(let i = 2; i <= pages; i++){ %>
                                    <li class="page-item" id="<%=i%>" onClick="setPage('<%=pages%>', '<%=i%>')"><span class="page-link no-border"><%=i%></span></li>
                                <% } %>
                            <li class="page-item page-link no-border" onclick="nextPage(<%=pages%>)">
                            <span aria-hidden="true">»</span>
                            </li>
                            </ul>
                            </nav>
                        <%}%>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</script>
<script src="js/autocomplete.js"></script>
<script src="js/findProfessionals.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize autocomplete for category
    new AutoComplete({
        inputId: 'selected_category',
        apiUrl: '/api/search/categories',
        minLength: 1,
        placeholder: '<%= t("Category") %>',
        noResultsText: '<%= t("NoCategories") || "No categories found" %>',
        debounceDelay: 300
    });

    // Initialize autocomplete for country
    new AutoComplete({
        inputId: 'country_search',
        apiUrl: '/api/search/countries',
        minLength: 1,
        placeholder: '<%= t("Country") %>',
        noResultsText: '<%= t("NoCountries") || "No countries found" %>',
        debounceDelay: 300
    });

    // Initialize autocomplete for city with dependency on country
    new AutoComplete({
        inputId: 'city_search',
        apiUrl: '/api/search/cities',
        minLength: 1,
        placeholder: '<%= t("City") %>',
        noResultsText: '<%= t("NoCities") || "No cities found" %>',
        dependsOn: 'country_search',
        debounceDelay: 300
    });
});
</script>
<%- include('partials/footer') %>