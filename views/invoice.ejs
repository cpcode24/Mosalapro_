<%- include('partials/header') %>

<section class="<%=bg%> padt-8">
   <div class="container pb-4">
    <div class="">
        <nav aria-label="breadcrumb" class="main-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
                <%if(usr.accountType=='provider') {%>
                    <li class="breadcrumb-item"><a href="/mybookings"><%= t('MyBookings') %></a></li>
                <% } else { %>
                    <li class="breadcrumb-item"><a href="/myrequests"><%= t('MyRequests') %></a></li>
                <% } %>
                <li class="breadcrumb-item active" aria-current="page"><%= t('Invoice') %></li>
            </ol>
        </nav>
    </div>
        <div class="invoice-content" id="invoice-content">
            <div class="container bootstrap snippets bootdey">
                <div class="row">
                    <div class="col-md-12">
                        
                        <div class="invoice-wrapper" id="invoice-container">
                            <div class=" d-flex justify-content-between">

                                <div class="col-md-3 col-lg-3 col-sm-6 col-6 ">
                                    <h6>MosalaPro LLC</h6>
                                    <ul class="contact-list font-weight-bold mt-2">
                                      <li>
                                        <div class="unit unit-spacing-xs">
                                          <div class="unit-left">
                                            <div class="icon icon-sm icon-primary novi-icon mdi mdi-map-marker"></div>
                                          </div>
                                          <div class="unit-body text-sm-left">30 N Gould St, Ste N Sheridan<br> WY 82801 USA.</div>
                                        </div>
                                      </li>
                                      <li>
                                        <div class="unit unit-spacing-xs">
                                          <div class="unit-left">
                                            <div class="icon icon-sm icon-primary novi-icon mdi mdi-phone"></div>
                                          </div>
                                          <div class="unit-body text-sm-left">+1 (800) 123 1234</div>
                                        </div>
                                      </li>
                                      <li>
                                        <div class="unit unit-spacing-xs">
                                          <div class="unit-left">
                                            <div class="icon icon-sm icon-primary novi-icon mdi mdi-email"></div>
                                          </div>
                                          <div class="unit-body text-sm-left">info@mosalapro.com</div>
                                        </div>
                                      </li>
                                      
                                    </ul>
                                  </div>


                                <div class="intro not-small-screen"><strong> <%= t('ServiceRequestInvoice') %> </strong></div>
                                
                                <div><img class="" src="images/mosalapro-logo-h.png" alt="" width="100" height="20"/></div>
                            </div>
                            <p class="small-screen text-center "><strong> <%= t('ServiceRequestInvoice') %> </strong></p>
                            <div class="payment-info">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <span><%= t('InvoiceNo') %></span>
                                        <strong class="box-pricing-title not-small-screen"><%=job._id%></strong>
                                        
                                    </div>
                                    <div class="col-sm-6 text-right">
                                        <span><%= t('InvoiceDate') %></span>
                                        <strong> <%= job.lastUpdate.getUTCMonth() + 1 %>/<%= job.lastUpdate.getUTCDate()%>/<%= job.lastUpdate.getUTCFullYear() %></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="payment-details">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <span><%= t('Client') %></span>
                                        <strong class="text-primary">
                                            <%=jobClient.firstName%>  <%=jobClient.lastName%>
                                        </strong>
                                        <p>
                                            <%=jobClient.address%><br>
                                            <%=jobClient.city%>,  <%=jobClient.country%><br>
                                            
                                        </p>
                                    </div>
                                <div class="col-sm-6 text-right">
                                <span><%= t('ServiceProvider') %></span>
                                <strong class="text-primary">
                                    <%=pro.firstName%>  <%=pro.lastName%>
                                </strong>
                                <p>
                                    <%=pro.address%><br>
                                    <%=pro.city%>,  <%=pro.country%><br>
                                    
                                </p>
                                </div>
                                </div>
                            </div>
                            <div class="line-items">
                            <div class="headers clearfix">
                                <div class="row">
                                    <div class="col-4"><%= t('Service') %></div>
                                    <div class="col-3 text-center"><%= t('Quantity') %></div>
                                    <div class="col-5 text-right"><%= t('Amount') %></div>
                                </div>
                            </div>
                            <div class="items">
                                <div class="row item">
                                    <div class="col-4 desc">
                                        <%=job.requestTitle%>
                                    </div>
                                    <div class="col-3 qty ">
                                        1
                                    </div>
                                    <div class="col-5 amount text-right">
                                         <%=job.budget%> <%= job.currency %>
                                    </div>
                                </div>
                                
                           
                            </div>
                            <div class="mt-3">
                                <span class="text-secondary"><%= t('TaskDescription') %>: </span>
                                <span class="extra-notes"><%=job.requestDescription%></span>

                            </div>
                            <div class="total text-right">
                            <p class="extra-notes">
                            <strong><%= t('ExtraNotes') %></strong>
                            <%= t('ExtraNotesText') %>
                            </p>
                            <div class="field">
                            <%= t('RateBudget') %>: <span> <b><%=job.budget%> <%= job.currency %></b>  - <%=job.budgetType%> </span>
                            </div>
                            <div class="field">
                            <%= t('OnlineFees') %> <span> <%=(0.05 * job.budget)%> <%= job.currency %></span>
                            </div>
                            <div class="field">
                            <%= t('Tax') %> <span> <%=parseFloat((0.07 * job.budget)).toFixed(2)%> <%= job.currency %></span>
                            </div>
                            <div class="field ">
                            <%= t('Total') %> <strong><span class="box-pricing-title dark-text"> <%=parseFloat(((0.07 * job.budget)+ (0.05 * job.budget)+ job.budget)).toFixed(2)%> <%= job.currency %></span></strong>
                            </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class=" d-flex justify-content-center mt-4 mb-4" id="ignorePDF">
        <button class="simple-btn-inv mr-3" id="btnPrint" >
            <b class="fa fa-print mr-1"></b> <%= t('DownloadPrintInvoice') %>
        </button>
        <% if(usr.accountType != 'provider') { %>
        <button class="simple-btn-inv">
            <a class="nolinkdeco" href="#payInvoiceModalCta" data-toggle="modal" data-caption-animate="fadeInUp" >
                <b class="fa fa-credit-card mr-1"></b> <%= t('SubmitPaymentInvoice') %>
            </a>
        </button>
        <% } %>
    </div>

</div>

</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.3/html2pdf.bundle.min.js" integrity="sha512-YcsIPGdhPK4P/uRW6/sruonlYj+Q7UHWeKfTAkBW+g83NKM+jMJFJ4iAPfSnVp7BKD4dKMHmVSvICUbE/V1sSw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script type="text/javascript" src="js/invoice.js"></script>
<!--script type="text/javascript" src="html2pdf.bundle.min.js"></script-->


