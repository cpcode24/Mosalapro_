
<%- include('partials/header') %>

<section class="<%=bg%> h-100 padt-8">
    <div class="container ">
          <div class="row">
            <div class="col">
              <nav aria-label="breadcrumb" class="main-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/"><%=t("Home")%></a></li>
                    <li class="breadcrumb-item"><a href="/service-requests"><%=t("ServiceRequests")%></a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%=job.requestTitle%></li>
                </ol>
            </nav>
        
            <div class="row px-4">
                 
                <div class="col-lg-8 col-md-12 col-sm-12">
                  <div class="container shadow-sm p-4 bg-white rounded mb-4">
                    <div class="d-flex justify-content-between w-100 p-4">
                      <h5><%=t("ServiceRequest")%>: <%=job.requestTitle%></h5>
                      <span id="booking-msg"></span>
                    </div>

                    <div class="modal-container-job px-4">
                      <input class="d-none" id="jobId" value="<%=job._id%>">
                      <input class="d-none" id="userName" value="<%=job.username%>">
                      <span id="mess" class="error_message"></span>
                      <div class="row  mt-2">
                          <div class="col">
                              <span class="job-details pl-2 mt-4"><b><%=t("Category")%> :</b> <%=job.category%></span> 
                          </div>
                      </div>
                      <div class="row mt-2">
                          <div class="col">
                              <span class="job-details pl-2 mt-4"><b><%=t("Budget")%> :</b> <%=job.budget%> <%=job.currency%> <%=convertedCurr%> - <%=job.budgetType%></span>
                          </div>
                      </div>

                      <div class="row mt-2">
                          <div class="col">
                              <span class="job-details pl-2 mt-4"><b><%=t("Deadline")%>:</b> <%=job.deadline%></span>
                          </div>
                      </div>

                      <div class="row mt-2">
                          <div class="col">
                              <span class="job-details pl-2"><b><%=t("Description")%>: </b><%=job.requestDescription%></span>
                          </div>
                      </div>
                      <div class="row">
                          <div class="col">
                              <h6 class="border-bottom mb-3"><%=t('Files')%></h6>
                              
                          </div>
                      </div>
                        <div class="row">
                          <% if (job.files.length == 0 || job.files[0] == 'no file'){ %>
                            <div class="col">
                                <span class="job-details pl-2"> <%=t("NoAttachedDocument")%></span>
                            </div>
                        <% } else { %>
                            <% let j = 0; job.files.forEach(file=>{ j++; %>

                            <!--span class="d-none" id="file-"><%= file%></a></p-->
                            <div title="Download file <%=j%>" data-toggle="tooltip" data-placement="bottom"  class=" col-sm-4 col-lg-2 tooltips cursor mb-4" >
                            <!--span class="job-details"><%=job.files.length%></span-->
                                <!-- Post Modern-->
                                <div class="d-flex justify-content-center px-4 px-auto" onClick="downloadFile('<%= file%>')" >
                                    <b class="fa fa-file-text fa-3x mb-1 file-icon" aria-hidden="true"></b>
                                    <span class="post-modern-time">  <%=job.requestTitle%>'s file <%=j%></span>
                                    
                                </div>
                                
                              </div>

                            <% }); } %>
                      </div>
                      
                      <div class="row border-bottom p-3 mt-1">
                          
                         
                          </div>
                        <% if(job.status != 'accepted' && job.status != 'completed') { %> 
                          <p class="post-modern-text mt-1 mb-4"><%=t("ReadDocumentsCarefully")%></p>
                        <% } else { %>
                          <p class="post-modern-text mt-1 mb-4"><%=t("ThisServiceRequestHas")%> <%=job.status %> <%=t('On')%> <%=job.lastUpdate %></p>
                        <% } %>
                      </div>
                        <div class="d-flex justify-content-center mt-3">
                            <button class="btn-job btn-primary-job" onClick="applyForJob('<%= owner._id%>', '<%=lang%>')" id="apply-btn"><%=t("ApplyForRequest")%></button>
                            <a href="#quotationModalCta" data-toggle="modal" data-caption-animate="fadeInUp"><button class="btn-job btn-primary-job-inv-blue tooltips ml-3" title="If you are not satisfied with the budget, you can provide your quote for this request." 
                            data-toggle="tooltip" data-placement="top" id="quote-btn"
                             ><%=t("ProvideQuote")%></button></a>
                             <a href="/service-requests"><button class="btn-job btn-primary-job-inv ml-3" id="prev-btn"><%=t("Back")%></button></a>
                        </div>
                    </div>
              </div>
        <div class="col-lg-4 col-md-12 col-sm-12 col">
          <div class="container shadow-sm mb-5 pb-1 bg-white rounded ">
            <div class="row">
              <div class="w-100 d-flex justify-content-center align-items-center border-bottom border-dark p-3">
                <h6><%=t('Client')%></h6>
              </div>
            </div>
            
            <div class=" col mt-2">
              <div class="card">
                  <div class="card-body p-4 d-flex align-items-center gap-3">
                      <img src="<%=owner?.photo %>"  alt="" class="rounded-circle" style="height:45px !important; width:45px !important;">
                      <div class="ml-3">
                          <h6 class="fw-semibold mb-0"><a href="#"><%=owner?.firstName %> <%=owner?.lastName %> </a></h6>
                          <span class="fs-2 d-flex align-items-center"><i class="ti ti-map-pin text-primary fs-3 me-1"> </i> 
                          <%=owner?.city%>, <%=owner?.country%></span>
                        </div>
                  </div>
              </div>
          </div>
              <center>
                <a href="#messageModalCta" data-toggle="modal" data-caption-animate="fadeInUp" class="simple-btn mr-3">
                  <b class="fa fa-envelope-o mr-1 mb-1" aria-hidden="true"></b><%=t("Message")%> <%=owner.firstName %>
                </a>
            </center>
              
              <%- include('partials/messageModal', {pro: owner}) %>
            
            </div>
            </div>
          </div>
        </div>
    </div>
    </div>
</section>

<%- include('partials/quotationModalCta') %>

<script src="js/jobApplication.js"></script>

  <%- include('partials/footer') %>