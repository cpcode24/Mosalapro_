
<%- include('partials/header') %>
<% let lim = 12; %>
<style>
/* Enhanced UI Styling for Job Requests */
.requests-header {
    background: linear-gradient(135deg, rgba(8, 173, 91, 0.1) 0%, rgba(32, 209, 55, 0.05) 100%);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(7, 91, 32, 0.1);
}

.requests-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #5A9E2F 0%, #3f8215 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.requests-subtitle {
    opacity: 0.8;
    font-size: 1.1rem;
    margin-bottom: 0;
    color: #666;
}

.filter-section {
    background: rgba(255,255,255,0.1);
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(5px);
}

.filter-section select {
    color: #3f8215;
	font-size: large;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.9);
    padding-left: 1.0rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.filter-section select:focus {
    border-color: #5A9E2F;
    box-shadow: 0 0 0 0.2rem rgba(90, 158, 47, 0.25);
}

/* Custom input styling to match existing design */
.filter-section input[type="text"] {
    color: #3f8215;
    font-size: large;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.9);
    padding-left: 1.0rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.filter-section input[type="text"]:focus {
    border-color: #5A9E2F;
    box-shadow: 0 0 0 0.2rem rgba(90, 158, 47, 0.25);
    outline: none;
}

/* Override AutoComplete styles to match design */
.autocomplete-container .autocomplete-results {
    background: white;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 0 0 10px 10px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    font-size: large;
}

.autocomplete-container .autocomplete-results li {
    color: #3f8215;
    font-weight: 500;
    padding: 0.75rem 1rem;
}

.autocomplete-container .autocomplete-results li:hover,
.autocomplete-container .autocomplete-results li.highlighted {
    background: rgba(90, 158, 47, 0.1);
    color: #3f8215;
}

.job-request-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: slideInUp 0.6s ease-out both;
}


.card.bg-light-job {
    background: rgba(255,255,255,0.95) !important;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    position: relative;
}

.card.bg-light-job::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(135deg, #5A9E2F 0%, #3f8215 100%);
}

.card.bg-light-job:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.card-body {
    position: relative;
    z-index: 1;
}

.btn-job {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    border: 2px solid transparent;
}

.job-details {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.cat-job {
    border-radius: 15px !important;
    font-weight: 500;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    transition: all 0.3s ease;
}

.load-more-container {
    text-align: center;
    padding: 2rem 0;
    margin-top: 2rem;
}

.load-more-btn {
    background: linear-gradient(135deg, #5A9E2F 0%, #3f8215 100%);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 1rem 2rem;
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.load-more-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(90, 158, 47, 0.4);
    color: white;
}

.load-more-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: white;
    animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.no-requests-message {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
}

.no-requests-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.3;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    .requests-title {
        font-size: 2rem;
    }
    
    .card.bg-light-job:hover {
        transform: translateY(-4px);
    }
}
</style>

<section class="<%=bg%>  padt-8 pb-3">
