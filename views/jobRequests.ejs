                                <!--a href="#jobDetailModal<%=i%>" data-toggle="modal" data-caption-animate="fadeInUp" class="btn-job btn-primary-job-inv">View Details</a--> 
                                
                            </div>
                                <div class=""><span class="float-md-right text-small mt-1"><%= t('PostedOn') %> <%= job.createdAt.getUTCMonth() + 1 %>/<%= job.createdAt.getUTCDate()%>/<%= job.createdAt.getUTCFullYear() %></span></div>
                            </div>
                        
                        </div>
                    </div>

                
                   
        
                        


        <% } ); } %>
        </div>
        <!--div class="text-center text-md-end d-md-block">
            <a href="#" class="text-primary">View more Jobs <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right fea icon-sm"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
        </div-->
     </div>
  </div>
</section>  
<%- include('partials/footer') %>

<script src="js/autocomplete.js"></script>
<script src="js/jobRequests.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize autocomplete for category with multi-language support
    const autocompleteInstance = new AutoComplete({
        inputId: 'selected_category',
        apiUrl: '/api/search/categories',
        minLength: 1,
        placeholder: '<%= t("BeginCategory") %>',
        noResultsText: '<%= t("NoCategories") || "No categories found" %>',
        debounceDelay: 300,
        onSelect: function(result, input) {
            // Trigger filtering when a category is selected
            filterRequestsByCat();
        }
    });

    // Move dropdown to body to escape stacking context issues
    setTimeout(() => {
        const autocompleteResults = document.querySelector('.autocomplete-results');
        const inputElement = document.getElementById('selected_category');

        if (autocompleteResults && inputElement) {
            // Move dropdown to body
            document.body.appendChild(autocompleteResults);

            // Override positioning to be relative to input
            autocompleteResults.style.position = 'absolute';
            autocompleteResults.style.zIndex = '999999';

            // Function to position dropdown relative to input
            const positionDropdown = () => {
                const inputRect = inputElement.getBoundingClientRect();
                autocompleteResults.style.top = (inputRect.bottom + window.scrollY) + 'px';
                autocompleteResults.style.left = inputRect.left + 'px';
                autocompleteResults.style.width = inputRect.width + 'px';
            };

            // Position on focus and input
            inputElement.addEventListener('focus', positionDropdown);
            inputElement.addEventListener('input', positionDropdown);
            window.addEventListener('scroll', positionDropdown);
            window.addEventListener('resize', positionDropdown);

            // Initial positioning
            positionDropdown();
        }
    }, 200);

    // Set initial value if user has a category
    <% if(usr.category && usr.category !== 'all') { %>
        const categoryInput = document.getElementById('selected_category');
        if (categoryInput) {
            // The AutoComplete class will handle the initial display through the API
            categoryInput.setAttribute('data-value', '<%=usr.category%>');
            // Trigger initial filter to show user's category results
            setTimeout(() => {
                filterRequestsByCat();
            }, 100);
        }
    <% } %>
});
</script>