
<%- include('partials/header') %>
<section class="<%=bg%> padt-8 pb-4" id="wsection">
    <div class="container" id="whole-sr-contnr">
        <div class="custom-container" id="cust-container">
            <nav aria-label="breadcrumb" class="main-breadcrumb">
                <ol class="breadcrumb"> 
                    <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
                    <li class="breadcrumb-item"><a href="/myrequests"><%= t('MyServiceRequests') %></a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%=request.requestTitle %></li>
                </ol>
            </nav>
            <div class="row mt-1 padx-4" id="sr-container">
                <div class="col-lg-8 col-md-12 col-sm-12">
                    <div class="card-u-pro-set pad-4">
                        <div class="card-body-u-pro-set tab-content px-4">
                            <div class="tab-pane active" id="request">
                                <h5><%=request.requestTitle %></h5>
                                <span id="reqMessage" class=""></span>
                                <span id="reqlang" value="<%=lang%>" style="display: none;"></span>
                                <div class="form-group mt-4">
                                    
                                    <% if(request.status == 'active' || request.status == 'cancelled') { %>
                                        <label for="fullName"><%= t('RequestTitle') %></label>
                                        <input type="text" class="form-control" id="requestTitle" aria-describedby="Requets title"  maxlength="70" value="<%=request.requestTitle%>">
                                    <% } %>
                                </div>
                                <div class="form-group">
                                    <label for="requestDesc"><%= t('RequestDescription') %></label>
                                    <% if(request.status == 'active' || request.status == 'cancelled') { %>
                                        <textarea type="text" class="form-control" id="requestDesc" name="requestDesc" min="20" aria-describedby="requestDesc" placeholder="Enter request description"><%=request.requestDescription%></textarea>
                                        <small id="requestDesc" class="form-text text-muted"><%= t('EnterAtLeast20Chars') %></small>
                                    <% }else { %>
                                        <textarea type="text" class="form-control" id="requestDesc" name="requestDesc"  readonly><%=request.requestDescription%></textarea>
                                    <% } %>
                                </div>
                                <div class="form-group">
                                        <label for="requestCat"><%= t('Category') %></label>
                                        <select class="form-control" aria-label="Select Category" name="category" id="requestCat" style="display: inline;">
                                            <option selected><%=request.requestCategory%></option>
                    
                                            <% if(cats){ cats.forEach(cat=>{ %>
                                              <% if (lang === 'fr') { %>
                                                <option name="<%= cat.name %>" value="<%= cat.name %>"> <%= cat.translations.fr.name %></option>
                                                <% } else { %>
                                                <option name="<%= cat.name %>" value="<%= cat.name %>"> <%= cat.name %></option>
                                        
                                        <% } }); } %>
                                          </select>
                                  </div>
                                <div class="form-group" id="sr-budget">
                                    <label for="budget"><%= t('Budget') %></label>
                                    <% if(request.status == 'active' || request.status == 'cancelled') { %>
                                        <!--input type="number" class="form-control" min="1" oninput="validity.valid||(value='');" id="requestBudget" name="budget" placeholder="$<%=request.budget%>" value="$<%=request.budget%>"-->
                                        <div class="row">
                                            <div class="col-lg-4 col-md-4 col-12">
                                                <div class="form-group">
                                                    <input type="number" min="1" oninput="validity.valid||(value='');" placeholder="<%=request.budget%>" value="request.budget" id="requestBudget" class="form-control" name="budget" oninput="this.className = 'input-field-input'">
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-4 col-12">
                                                <div class="form-group">
                                                    <select name="reBudgetCurrency" id="requestBudgetCurrency" class="form-control" >
                                                        <option value="<%=request.currency%>"> <%=request.currency%></option>
                                                        <% if(request.currency != 'XAF') { %> <option value="XAF"> FCFA</option> <% } %>
                                                        <% if(request.currency != 'USD') { %> <option value="USD"> USD </option> <% } %>
                                                        <% if(request.currency != 'EUR') { %> <option value="XAF"> EUR </option> <% } %>
                                                        <% if(request.currency != 'GBP') { %> <option value="GBP"> GBP </option> <% } %>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-4 col-md-4 col-12">
                                                <div class="form-group">
                                                    <select name="budgetType" id="budgetType" class="form-control" value="<%=request.budgetType%>" >
                                                    <option value="Per hour"> <%= t('PerProject') %></option>
                                                    <option value="Per project"> <%= t('PerHour') %></option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    <%} else { %>

                                        <div class="row">
                                            <div class="col-lg-6 col-md-6 col-12">
                                            <div class="form-group">
                                                <input class="form-control" id="requestBudget" name="budget" value="<%=request.budget%> <%=request.currency%>" readonly>
                                            </div>
                                            </div>
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <div class="form-group">
                                                    <input class="form-control" id="requestBudgetType" name="budgetType" value="<%=request.budgetType%>" readonly>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="form-group">
                                    <label for="deadline"><%= t('Deadline') %></label>
                                    <% if(request.status == 'active' || request.status == 'cancelled') { %>
                                        <!--div class="datepicker date input-group p-0 shadow-sm" >
                                            <input placeholder="<%=request.deadline%>" id="datepicker" name="requestDeadline" oninput="this.className = ' '">
                                        </div-->
                                        <label class="required-field" for="datepicker"><%= t('Deadline') %></label>
                                        <div class="form-group">
                                            <div class="input-group">
                                                <input class="form-control" onfocus="(this.type='date')" id="datepicker" placeholder="<%=request.deadline%>" name="requestDeadline" required oninput="this.className = 'form-control'">
                                                
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <input class="form-control" id="deadline" name="deadline_"  value="<%=request.deadline%>" readonly>
                                    <% } %>
                                </div>
                                <div class="form-group mb-4">
                                    <h6 class="border-bottom mb-1"><%= t('Files') %></h6>
                                    <div class="row mt-3">
                                
                                        <%  if (request.files.length > 0 && request.files[0] != "" && request.files[0] != 'no file' ) { %>
                                            <% let j = 0; request.files.forEach(file=>{ j++; %>
        
                                            <!--span class="d-none" id="file-"><%= file%></a></p-->
                                            <div title="Download file <%=j%>" data-toggle="tooltip" data-placement="bottom"  class=" col-sm-4 col-lg-2 tooltips cursor mb-4" >
                                            <!--span class="job-details"><%=request.files.length%></span-->
                                                <!-- Post Modern-->
                                                <div class="d-flex justify-content-center px-4 px-auto" onClick="downloadFile('<%= file%>')" >
                                                    <b class="fa fa-file-text fa-3x mb-1 file-icon" aria-hidden="true"></b>
                                                    <span class="post-modern-time">  <%= t('AttachedFile') %></span>
                                                </div>
                                                
                                              </div>
        
                                            <% } ); } else { %>
                                                <p class="text-small text-light mb-2 mt-2 ml-3"><%= t('NoRequirementDocument') %></p>
                                            <% } %>
                                            
                                    </div>
                                    <% if(request.status == 'active' || request.status == 'cancelled') { %>
                                        <span id="attach_err_msg mt-2"></span> <br/>
                                        <label for="file-input" class="attach-btn mt-4">
                                            <i class="fas fa-paperclip mt-2"></i> <%= t('AttachRequirementDoc') %>
                                        </label>
                                        <input id="file-input" name="file" type="file" accept=
                                        "application/msword, application/vnd.ms-excel, application/vnd.ms-powerpoint,
                                        text/plain, application/pdf, image/*" style="display: none;" >  
                                        <pre class="output"><%= t('SelectedFile') %>:</pre> 
                                    <% } %>     
                                </div>
                                <% if(request.status == "active") {%>
                                    <div class="d-flex justify-content-center mt-2">
                                        <button type="submit" class="btn-job btn-primary-job-inv-dgr mr-3" href="#cancelRequestConfModalCta" data-toggle="modal" data-caption-animate="fadeInUp" ><%= t('Cancel') %></button>
                                        <button onClick ="onRequestSubmit('<%=request._id%>', '<%=request.budget%>')" class="btn-job btn-primary-job-inv"><%= t('SaveChanges') %></button>
                                        <button onClick="reset('<%=request._id%>')" type="reset" class="btn-job btn-primary-job-inv-blue ml-3"><%= t('ResetChanges') %></button>
                                        
                                    </div>
                                <% } else if(request.status == "cancelled") { %>
                                    <div class="d-flex justify-content-center mt-2">
                                        <button onClick="resubmit('<%=request._id%>')" type="submit" class="btn-job btn-primary-job-inv-dgr mr-3"><%= t('Resubmit') %></button>
                                    </div>
                                <% } else if(request.status == "booked") { %>
                                    <div class="d-flex justify-content-center mt-2">
                                        <button type="submit" class="btn-job btn-primary-job-inv-dgr mr-3" onclick="showModal('#cancelUserBookingConfModalCta')"  ><%= t('Cancel') %></button>
                                        <button onClick ="onRequestSubmit('<%=request._id%>', '<%=request.budget%>')" class="btn-job btn-primary-job-inv"><%= t('SaveChanges') %></button>
                                        <button onClick="reset('<%=request._id%>')" type="reset" class="btn-job btn-primary-job-inv-blue ml-3"><%= t('ResetChanges') %></button>          
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                

                <div class="col-lg-4 col-md-12 col-sm-12 col">
                    <div class="container shadow-sm mb-5 pb-2 bg-white rounded ">
                      <div class="row">
                        <div class="w-100 d-flex justify-content-center align-items-center border-bottom border-dark p-3">
                        <% if(request.status == "active" ) {%>
                          <h6><%= t('Applicants') %></h6>
                        <% } else if(request.status != 'cancelled') { %>
                          <h6><%= t('ServiceProvider') %></h6>
                        <% } %>
                        </div>
                      </div>
                      <% if(request.status != 'cancelled') { %>
                        <% if(interestedPros.length > 0) { interestedPros.forEach(pro=>{  %>
                        <a href="/applicant?p=<%=pro?._id%>&j=<%=request._id%>%>"> 
                            <div class=" col mt-2">
                                <div class="card">
                                    <div class="card-body p-4 d-flex align-items-center gap-3">
                                        <img src="<%=pro?.photo %>"  alt="" class="rounded-circle" style="height:45px !important; width:45px !important;">
                                        <div class="ml-3">
                                            <h6 class="fw-semibold mb-0"><a href="/applicant?p=<%=pro?._id%>&j=<%=request._id%>%>"><%=pro?.firstName %> <%=pro?.lastName %> </a></h6>
                                            <span class="fs-2 d-flex align-items-center"><i class="ti ti-map-pin text-primary fs-3 me-1"> </i> 
                                            <%=pro?.city%>, <%=pro?.country%></span>
                                          </div>
                                    </div>
                                </div>
                            </div>
                            </a>
                            <% if(pro?.quotation) { %>

                                <div class="card mt-3 mx-auto" style="width: 18rem;" id="qr-container">
                                    <div class="card-body" id="qr-card">
                                    <h6 class="card-title"><%= t('NewQuoteFrom') %> <%=pro.firstName%> </h6>
                                    <p class="card-text"><%= t('Message') %>: <i><%=pro?.quotation.quotationDescription%></i></p>
                                    </div>
                                    <ul class="list-group list-group-flush">
                                    <li class="list-group-item"><%= t('NewBudget') %>: <b><%=pro?.quotation.budget%> <%=request.currency%> / <%=pro?.quotation.budgetType%></b></li>
                                    <% if(pro?.quotation.timeOfCompletion) { %>
                                        <li class="list-group-item"><%= t('Duration') %>: <b><%=pro?.quotation.timeOfCompletion %> <%= t('Hours') %> </b></li>
                                    <% } %>
                                    </ul>
                                    <div class="card-body d-flex justify-content-center">
                                    <button class="btn-job btn-primary-job-inv" onclick="acceptQuotation('<%=pro.quotation._id%>','<%=request._id%>', '<%=pro._id%>')"><%= t('Accept') %></button>
                                    <button class="btn-job btn-primary-job-inv-dgr ml-2" onclick="rejectQuotation('<%=pro.quotation._id%>', '<%=request._id%>', '<%=pro._id%>')"><%= t('Reject') %></button>
                                    </div>
                                </div>
                                
                            <% } %>
                        <% }); } else{ %>
                            <div class="d-flex justify-content-center mt-2 p-4"><span><%= t('NoApplicationFound') %></span></div>
                        <% } %>

                        <% if (request.newDeadlineRequest != undefined) { %>
                            
                            <div class="card mt-3 mx-auto" style="width: 18rem;" id="dr-container">
                                <div class="card-body" id="dr-card">
                                <h6 class="card-title"><%= t('DeadlineExtensionRequest') %> </h6>
                                <p class="card-text"><%= t('NewDeadlineRequested') %>: <b><%=request.newDeadlineRequest.newDeadline%></b></p>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"><%= t('Reason') %>: <b><%=request.newDeadlineRequest.reason%> </b></li>
                                </ul>
                                <div class="card-body d-flex justify-content-center">
                                <button class="btn-job btn-primary-job-inv" onclick="acceptNewDeadline('<%=interestedPros[0]._id %>')"><%= t('Accept') %></button>
                                <button class="btn-job btn-primary-job-inv-dgr ml-2" onclick="rejectNewDeadline('<%=interestedPros[0]._id %>')"><%= t('Reject') %></button>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                    <% if(request.status != "cancelled" && request.status != 'active' && interestedPros.length > 0) { %> 
                        <div class="d-flex justify-content-center mt-3 mb-3"><a href="/invoice?sr=<%=request._id%>&p=<%=interestedPros[0]?._id%>">
                            <button type="reset" class="btn-job btn-primary-job-inv-blue ml-3"><%= t('ViewInvoice') %></button></a>
                        </div>
                    <% } else if(request.status == "active" && interestedPros.length > 2) { %>
                        <div class="d-flex justify-content-center"><a href="/applicants/<%=request._id%>">
                            <button type="reset" class="btn-job btn-primary-job-inv-blue ml-3 my-4"><%= t('ViewAllApplicants') %></button></a>
                        </div>
                      <% } %>  
                    </div>
                    
                </div>
            </div>
            
            <div class="row mar-4 padx-4" id="delivery-container">
                <div class="col-lg-8 col-md-12 col-sm-12 col-12">
                    <div class="card-u-pro-set p-4">
                        <div class="card-body-u-pro-set tab-content px-4">
                            <h5 class="border-bottom mb-2"><%= t('Delivery') %>  <% if (timelines.length > 0 && timelines[0].revisionReason) {%> <span class="text-light text-muted"> - <%= t('UnderReview') %> </span><% } %>
                                          <% if (request.status == 'accepted') {%> <span class="text-light text-muted"> - <%= t('Accepted') %> </span><% } %></h5>
                            <%  for(let i = 0; i < timelines.length; i++) { %>
                                <div>
                                    <div>
                                        <p class="text-light text-primary mt-2 mb-2 ml-2"> <%= pro?.firstName %> <%= t('HasCompletedServiceRequest') %></p>
                                        <span class="mt-3 text-primary ml-2"><%= t('DateAndTime') %>: </span><span class="ml-2"><%=timelines[i].createdAt%></span>
                                    </div>
                                    <span class="mt-3 text-primary ml-2"><%= t('Comment') %>:</span>
                                    <i class="mt-0 ml-2">
                                        <%=timelines[i].comment %>
                                    </i>
                                    <% if(timelines[i].file) { %>
                                        <div title="Download delivery file" data-toggle="tooltip" data-placement="bottom" class="mr-4 cursor " onclick="downloadFile('<%=timelines[i].file%>')">
                                            <b class="fa fa-file-text mb-1 file-icon" aria-hidden="true"></b>
                                            <span class="pl-2"><%=timelines[i].file %></span>
                                        </div>
                                    <% } %>
                                    <br />
                                    
                                    <% if (timelines[i].revisionReason) { %> 
                                        <div class="ml-2">
                                            <h6 class="border-bottom mt-3 mb-2"> Revision Request</h6>
                                            <span class="text-primary ml-2">Date & time: </span><span class="ml-2"><%=request.lastUpdate%></span></br>
                                            <span class="mt-3 text-primary ml-2">Comment:</span>
                                            <i class="mt-0 ml-2"><%=timelines[i].revisionReason%></i>
                                    
                                        </div>
                                        

                                    <% } else if(request.status == 'accepted') { %>
                                        <div class="ml-2">
                                            <h6 class="text-light mt-2"> You accepted the final deliverable of this service request on:</h6>
                                            <span><%=request.lastUpdate%></span>
                                        </div>
                                        <div class="mt-3 mb-3 ml-2">
                                            
                                            <button type="submit" class="btn-job btn-primary-job-inv mr-3" onclick="window.open('/feedback/<%=request._id%>')" > <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-half mb-1 mr-1" viewBox="0 0 16 16">
                                                <path d="M5.354 5.119 7.538.792A.52.52 0 0 1 8 .5c.183 0 .366.097.465.292l2.184 4.327 4.898.696A.54.54 0 0 1 16 6.32a.55.55 0 0 1-.17.445l-3.523 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256a.5.5 0 0 1-.146.05c-.342.06-.668-.254-.6-.642l.83-4.73L.173 6.765a.55.55 0 0 1-.172-.403.6.6 0 0 1 .085-.302.51.51 0 0 1 .37-.245zM8 12.027a.5.5 0 0 1 .232.056l3.686 1.894-.694-3.957a.56.56 0 0 1 .162-.505l2.907-2.77-4.052-.576a.53.53 0 0 1-.393-.288L8.001 2.223 8 2.226z"/>
                                              </svg>
                                              Rate provider</button>
                                        </div>
                                    <% } else if(request.status == 'accepted & rated') { %>
                                        <div class="mt-3 mb-3 ml-2">
                                            
                                           <!-- <p> You have already rated the provider for this task.</p>  -->
                                        <% if(rating) { %>    
                                           <h6 class="border-bottom mt-4 mb-3"> Your Feedback: </h6>
                                           <div class="ml-2"> <span class="text-primary">Rating: &nbsp;</span>
                                             <% let i = 0; for(i = 0; i < rating.rating; i++) { %>
                                                 <li class="d-inline"><b class="fa-star fa-sm rating-star-color fas "></b></li>
                                             <% } if(i < 5) while(i < 5) { %>
                                                 <li class="d-inline"><b class="fa-star-o fa-sm rating-star-color fas "></b></li>
                                             <% i++; } %>
                                             </div>
                                             <p class="mt-1 ml-2"><span class="text-primary">Comment: </span> <i>"<%=rating.userComment %> "</i></p>
                                             <div class="mt-2 d-flex justify-content-center"><a href="/feedback/<%=request._id%>" class="btn-job btn-primary-job" > Edit feedback</a></div>
                                        <% } %>
                                        </div>
                                    <% } else {%>
                                        <div class="mt-3 d-flex justify-content-center">
                                                <button onclick="showModal('#requestRevisionModalCta')" type="submit" class="btn-job btn-primary-job-inv-blue mr-3" data-toggle="modal" data-caption-animate="fadeInUp" ><%= t('RequestRevision') %></button>
                                                <button type="submit" class="btn-job btn-primary-job-inv mr-3" onclick="showAcceptModal()" ><%= t('AcceptDelivery') %></button>
                                        </div>
                                    <% } %>

                                    <hr class="my-3 mt-3" />
                                </div>
                            <% }%>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

<div id="successPopup" class="popup-container" style="display: none;">
    <div class="popup-content">
        <h2><%=t("Success")%>!</h2>
        <p><%=t("ChangesSavedSuccessfully")%></p><br />
         <button id="closePopup" class="btn btn-primary-job">Okay</button>
    </div>
</div>
</section>



<%- include('partials/requestRevisionModal') %>
<%- include('partials/cancelUserBookingConfModal') %>
<%- include('partials/cancelRequestConfModal') %>
<% if(interestedPros && interestedPros.length > 0){ %>
    <%- include('partials/acceptDeliveryModalCta') %>
<% } %>
<script src="https://unpkg.com/gijgo@1.9.14/js/gijgo.min.js" type="text/javascript"></script>

<script>
      // Set minimum date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('datepicker').setAttribute('min', today);

    const dateInput = document.getElementById('datepicker');
    dateInput.setAttribute('min', today);
    dateInput.addEventListener('click', () => {
        dateInput.showPicker();
    });

    const output = document.querySelector(".output");
    const fileInput = document.querySelector("#file-input");
    const attach_err_msg = document.getElementById("attach_err_msg");
    if(fileInput){
        fileInput.addEventListener("change", async () => {
            if(fileInput.files.length > 0){
                const fileSize = fileInput.files[0].size;
                const fileSizeInMB = fileSize / (1024*1024);
                if(fileSizeInMB > 10){
                    attach_err_msg.classList.add("error_message");
                    attach_err_msg.innerHTML = "<%= t('FileSizeTooLarge') %>";
                    await new Promise(r => setTimeout(r, 3500));
                    attach_err_msg.innerHTML = "";
                    return;
                }
            }
        for (const file of fileInput.files) {
            output.innerText += `\n${file.name}`;
        }
        });
    }
</script>
<script src="js/manageRequest.js"></script>
<%- include('partials/footer') %>
                                    