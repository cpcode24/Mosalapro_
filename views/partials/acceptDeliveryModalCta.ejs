<div class="modal fade" id="acceptDeliveryModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h6 class="mt-1 mb-1 text-center"><%= t('AcceptDeliveryTitle') %></h6>
            </div>
        <div class="form-container">
                    
                    <span class="d-none" name="acc_message" id="acc_message"></span>
                    <div class="row mt-1">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div class="form-group">
                            <span class="text-lg-center text-primary"><%= t('AcceptDeliveryMessage') %></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col d-flex justify-content-center mb-2">
                            <input type="button" onClick="acceptDelivery('<%=request._id%>', '<%=interestedPros[0]._id %>')" name="submit" class="btn-job btn-primary-job" value="<%= t('AcceptDeliveryYes') %>">
                            <input type="button" onclick="hideAcceptModal()" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="<%= t('AcceptDeliveryCancel') %>">
                        </div>
                    </div>
              </div>
  
          </div>
        </div>
      </div>
    </div>
