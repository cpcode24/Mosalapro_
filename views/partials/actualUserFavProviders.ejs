<section class="<%=bg%>">
    <div class="container px-4">
        <h3 class="ml-3 mb-2 text-light tracking-wide"><%= t('MyFavPros') %></h3>
        <div class="row p-3">
            
            <%
                let limit_ = 8;
                if(favProviders.length <= 8) 
                    limit_ = favProviders.length;
                for(let j = 0; j < limit_; j++){ 
                    if(favProviders[j]) { 
                        if(favProviders[j].photo) {
                            if(!favProviders[j].photo.includes("https://")) favProviders[j].photo = "/photo/"+favProviders[j].photo;
                          } else favProviders[j].photo = "/photo/default.png"; 
                        %>
                <!--div class="col-lg-3 col-md-3 col-sm-6 col-12 custom-px">
                    <div class="text-center card-box-pro">
                        <div class="member-card pt-2 pb-2"-->
                <div class=" col-md-6 col-xl-4 col-12">
                    <div class="card">
                        <div class="card-body p-4 d-flex align-items-center gap-3">
                            <!--div class="thumb-lg member-thumb mx-auto"><img src="<%=favProviders[j].photo %> " class="rounded-circle img-thumbnail" alt="profile-image"></div-->
                            <img src="<%=favProviders[j].photo %>"  alt="" class="rounded-circle" style="height:45px !important; width:45px !important;">
                            <div class="ml-3">
                                <h6 class="fw-semibold mb-0"><a href="/pro-profile/<%=favProviders[j]._id%>"><%=favProviders[j].firstName %> <%=favProviders[j].lastName %> </a></h6>
                                <span class="fs-2 d-flex align-items-center"><i class="ti ti-map-pin text-primary fs-3 me-1"><%=favProviders[j].role %> </i> -
                                <%=favProviders[j].city%>, <%=favProviders[j].country%></span>
                              </div>
                    
                        </div>
                    </div>
                </div>
            <% } } %>
            </div>

        </div>
</section>