<!-- Provider Availability Manager -->
<div class="availability-manager">
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-calendar-check"></i> <%= t('ManageAvailability') %>
            </h5>
        </div>
        <div class="card-body">
            <!-- Tabs for Recurring and Specific -->
            <ul class="nav nav-tabs mb-3" id="availabilityTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="recurring-tab" data-bs-toggle="tab"
                            data-bs-target="#recurring" type="button" role="tab">
                        <i class="fas fa-repeat"></i> <%= t('RecurringSchedule') %>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="specific-tab" data-bs-toggle="tab"
                            data-bs-target="#specific" type="button" role="tab">
                        <i class="fas fa-calendar-day"></i> <%= t('SpecificDates') %>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="availabilityTabContent">
                <!-- Recurring Schedule Tab -->
                <div class="tab-pane fade show active" id="recurring" role="tabpanel">
                    <div class="mb-3">
                        <button class="btn btn-success btn-sm" onclick="showAddRecurringModal()">
                            <i class="fas fa-plus"></i> <%= t('AddTimeSlot') %>
                        </button>
                    </div>

                    <!-- Recurring Schedule Display -->
                    <div id="recurringScheduleList">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Specific Dates Tab -->
                <div class="tab-pane fade" id="specific" role="tabpanel">
                    <div class="mb-3">
                        <button class="btn btn-success btn-sm" onclick="showAddSpecificModal()">
                            <i class="fas fa-plus"></i> <%= t('AddSpecificDate') %>
                        </button>
                    </div>

                    <!-- Specific Dates Display -->
                    <div id="specificDatesList">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Recurring Schedule Modal -->
<div class="modal fade" id="addRecurringModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('AddRecurringTimeSlot') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addRecurringForm">
                    <div class="mb-3">
                        <label class="form-label"><%= t('DayOfWeek') %></label>
                        <select class="form-select" id="recurring_dayOfWeek" required>
                            <option value="0"><%= t('Sunday') %></option>
                            <option value="1"><%= t('Monday') %></option>
                            <option value="2"><%= t('Tuesday') %></option>
                            <option value="3"><%= t('Wednesday') %></option>
                            <option value="4"><%= t('Thursday') %></option>
                            <option value="5"><%= t('Friday') %></option>
                            <option value="6"><%= t('Saturday') %></option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><%= t('StartTime') %></label>
                            <input type="time" class="form-control" id="recurring_startTime" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><%= t('EndTime') %></label>
                            <input type="time" class="form-control" id="recurring_endTime" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('Note') %> (<%= t('Optional') %>)</label>
                        <textarea class="form-control" id="recurring_note" rows="2" maxlength="200"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                <button type="button" class="btn btn-primary" onclick="addRecurringSlot()"><%= t('Add') %></button>
            </div>
        </div>
    </div>
</div>

<!-- Add Specific Date Modal -->
<div class="modal fade" id="addSpecificModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('AddSpecificDate') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addSpecificForm">
                    <div class="mb-3">
                        <label class="form-label"><%= t('Date') %></label>
                        <input type="date" class="form-control" id="specific_date" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><%= t('StartTime') %></label>
                            <input type="time" class="form-control" id="specific_startTime" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><%= t('EndTime') %></label>
                            <input type="time" class="form-control" id="specific_endTime" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('Note') %> (<%= t('Optional') %>)</label>
                        <textarea class="form-control" id="specific_note" rows="2" maxlength="200"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                <button type="button" class="btn btn-primary" onclick="addSpecificSlot()"><%= t('Add') %></button>
            </div>
        </div>
    </div>
</div>

<style>
.availability-manager .day-schedule {
    border-left: 3px solid #007bff;
    padding-left: 15px;
    margin-bottom: 15px;
}

.availability-manager .time-slot {
    background: #f8f9fa;
    padding: 10px;
    border-radius: 5px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.availability-manager .time-slot:hover {
    background: #e9ecef;
}

.availability-manager .time-range {
    font-weight: 500;
    color: #495057;
}

.availability-manager .slot-actions {
    display: flex;
    gap: 5px;
}
</style>

<script src="/js/availabilityManager.js"></script>
