<div class="modal fade" id="changePasswordModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h6 class="mt-1 mb-1 text-center"> <%=t('ChangeCurrentPassword')%></h6>
            </div>
        <div class="form-container">
                    <div class="row mt-1">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div class="form-group">
                                <span name="err_message" id="err_message"></span><br>
                                <span class="text-lg-center" id="confPassChangeMessage"><%=t('ChangePassInstructions')%></span>
                                <input type="password" id="oldPass" name="oldPass" class="form-control mt-2" placeholder="<%=t('EnterCurrentPassword')%>" oninput="this.className = 'form-control mt-2'">
                                <input type="password" id="newPass" name="newPass" class="form-control mt-2" placeholder="<%=t('NewPassword')%>" oninput="this.className = 'form-control mt-2'">
                                <input type="password" id="confNewPass" name="confNewPass" class="form-control mt-2" placeholder="<%=t('ConfirmNewPassword')%>" oninput="this.className = 'form-control mt-2'">
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col d-flex justify-content-center mb-2">
                            <input type="button" onClick="changePassword()" name="submit" class="btn-job btn-primary-job-inv" value="<%=t('ChangePasswordLabel')%>">
                            <input type="button" onClick="hideModal('#changePasswordModalCta')" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="<%=t('Cancel')%>">
                        </div>
                    </div>
              </div>
  
          </div>
        </div>
      </div>
    </div>
   