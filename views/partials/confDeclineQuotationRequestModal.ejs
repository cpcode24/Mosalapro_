<div class="modal fade" id="confDeclineQuotationRequestModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h6 class="mt-1 mb-1 text-center"> Reject Quotation Request Confirmation</h6>
            </div>
        <div class="form-container">
                    <div class="row mt-1">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div class="form-group">
                            <span class="text-small" id="confRejMessage"></span><br>
                            <span class="text-lg-center text-primary" id="confMessage">Are you sure you want to reject the quotation request? Once you confirm this, you can no longer edit or submit a quote for the request.</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col d-flex justify-content-center mb-2">
                            <input type="button" onClick="declineQuotationRequest('<%=qr._id %>', '<%=customer._id%>')" name="submit" class="btn-job btn-primary-job-inv-dgr" value="Yes, reject the quotation request">
                            <input type="button" onClick="hideConfModal('#confDeclineQuotationRequestModalCta')" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="Cancel">
                        </div>
                    </div>
              </div>
  
          </div>
        </div>
      </div>
    </div>