<div class="modal fade" id="confirmAccountDeletionModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h6 class="mt-1 mb-1 text-center"> <%=t('AccountDeletionConfirmation')%></h6>
            </div>
        <div class="form-container">
                    
                    <span class="d-none" name="error" id="err"></span>
                    <div class="row mt-1">
                        <div class="col-lg-12 col-md-12 col-12">
                            <div class="form-group">
                            <span class="text-small" id="errConfDelMessage"></span><br>
                            <span class="text-lg-center text-primary" id="confMessage"> <%=t("AccountDeletionMessage")%></span>
                            <br><span><%=t("EnterPasswordToDeleteAccount")%></span>
                            <input type="password" id="delAccModalPass" name="delAccModalPass" class="form-control mt-2" placeholder="<%=t('Password')%>" oninput="this.className = 'form-control mt-2'">
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col d-flex justify-content-center mb-2">
                            <input type="button" onClick="deleteAccount('<%=usr._id %>')" name="submit" class="btn-job btn-primary-job-inv-dgr" value="<%=t('ConfAccountDeletion')%> (<%= usr.accountType%>)">
                            <input type="button" onClick="hideModal('#confirmAccountDeletionModalCta')" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="<%=t('Cancel')%>">
                        </div>
                    </div>
              </div>
  
          </div>
        </div>
      </div>
    </div>
   