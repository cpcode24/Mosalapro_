
<div class="modal fade" id="logModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      
      <div class="modal-content">
        
        <ul class="nav nav-tabs nav-justified mb-1" id="ex1" role="tablist">
          <li class="nav-item" role="presentation">
            <a class="nav-link active " id="tab-login-u" data-toggle="pill" href="#pills-login" role="tab"
              aria-controls="pills-login" aria-selected="true"><%= t('Login') %></a>
          </li>
        </ul>
        <!-- Pills navs -->
        <!-- Pills content -->
        <div class="tab-content ">
          <div class="tab-pane fade show active" id="pills-login" role="tabpanel" aria-labelledby="tab-login-u">
        
            <div class="d-inline">
              <a class="btn btn-lg btn-block btn-primary p-2" onclick="window.open ('/auth/facebook', ''); return false" href="javascript:void(0);" role="button" style="background-color: #4267b2;"
                  type="submit">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="mr-2 mb-1" viewBox="0 0 16 16">
                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/>
                  </svg> <%= t('ContinueWithFacebook') %></a>
              <a class="btn btn-lg btn-block btn-primary p-2 start-0" href="/auth/google" role="button" style="border: 1px gainsboro solid; background-color: #fff;"
                  type="submit">
                  <svg class="mr-2 mb-1" width="18" height="19" viewBox="0 0 18 19" xmlns="http://www.w3.org/2000/svg"><path d="M9 7.84363V11.307H13.8438C13.6365 12.428 12.9994 13.373 12.0489 14.0064V16.2534H14.9562C16.6601 14.6951 17.641 12.4029 17.641 9.67839C17.641 9.04502 17.5854 8.43176 17.4792 7.84865H9V7.84363Z" fill="#3E82F1"></path><path d="M9.00001 14.861C6.65394 14.861 4.67192 13.2876 3.96406 11.1714H0.955627V13.4937C2.43709 16.4142 5.48091 18.4198 9.00001 18.4198C11.432 18.4198 13.4697 17.6206 14.9562 16.2533L12.0489 14.0064C11.245 14.5443 10.2135 14.861 9.00001 14.861Z" fill="#32A753"></path><path d="M3.96404 5.45605H0.955617C0.348876 6.66246 0 8.02972 0 9.47238C0 10.915 0.348876 12.2823 0.955617 13.4887L3.96404 11.1714C3.78202 10.6335 3.6809 10.0605 3.6809 9.47238C3.6809 8.88426 3.78202 8.31122 3.96404 7.77336V5.45605Z" fill="#F9BB00"></path><path d="M0.955627 5.45597L3.96406 7.77327C4.67192 5.65703 6.65394 4.08368 9.00001 4.08368C10.3197 4.08368 11.5079 4.53608 12.4382 5.42078L15.0219 2.85214C13.4646 1.40948 11.427 0.52478 9.00001 0.52478C5.48091 0.52478 2.43709 2.53043 0.955627 5.45597Z" fill="#E74133"></path></svg>
                  <span style="color:black;"><%= t('ContinueWithGoogle') %></span></a>
              <button class="btn btn-lg btn-block btn-primary p-2 mt-2" data-toggle="modal" data-target="#phoneAuthModal" data-dismiss="modal" type="button" style="border: 1px solid #7c7e7c; background-color: #7c7e7c;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="mr-2 mb-1">
                    <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg> <%= t('ContinueWithPhone') %></button>

            </div>
           
                <p class="text text-center"><%= t('OrFillInformationBelow') %></p>
                <!--form id="" action="/login-u" method="post"-->
                <% if(link) { %>
                  <input name="link" value="<%=link%>" style="display:none"> 
                <% } if(lang) { %>
                  <span name="lang" id="lang" value="<%=lang%>" style="display:none"></span>
                <% } %>
                <div  class="d-flex flex-column justify-content-center align-items-center"> 
                  <span name="message" id="message" class="error_message "> </span>
                </div>
                  <div id="loginForm">
                      
                    <div class="row mt-1">
                      <div class="col">
                          <!-- Email input -->
                          <div class="form-outline ">
                              <input type="email" id="username" class="form-control" placeholder="<%= t('EmailAddress') %>" name="username"  autocomplete="on" required/>
                          </div>
                      </div>
                    </div>
                    <div class="row mt-2">
                      <div class="col">
                          <!-- Password input -->
                        <div class="form-outline"> 
                            <input type="password" id="password" class="form-control" placeholder="<%= t('Password') %>" name="password" autocomplete="on"  required/>
                        </div>
                      </div>
                  </div>
                  <div  class="d-flex flex-column justify-content-center align-items-center"> 
                    <span><a class="text-primary" href="/pass-recovery"><%= t('ForgotPassword') %></a></span>
                  </div>
                  <div class="row mt-1">
                    <div class="col">
                                <!-- Submit button -->
                            <button type="submit" class="btn btn-block simple-btn big p-2 mb-2" name="login-u" onClick="onLoginSubmit()"><%= t('Login') %></button>
                    </div>
                  </div>
                  </div>
            <!--/form-->
            <div  class="d-flex flex-column justify-content-center align-items-center"> 
              <span><%= t('NewHere') %>?  <a class="text-primary" href="#regModalCta" data-toggle="modal" data-dismiss="modal" data-caption-animate="fadeInUp"><%= t('CreateAccount') %></a></span>
            </div>
          </div>
          
        </div>
      
      </div>
    </div>
  </div>

  
 