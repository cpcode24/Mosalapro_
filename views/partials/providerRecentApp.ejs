<style>
/* Enhanced UI Styling for Recent Applications */
.recent-apps-header {
    background: linear-gradient(135deg, rgba(8, 173, 91, 0.1) 0%, rgba(32, 209, 55, 0.05) 100%);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(7, 91, 32, 0.1);
}

.recent-apps-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #5A9E2F 0%, #3f8215 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.recent-apps-subtitle {
    opacity: 0.8;
    font-size: 1rem;
    margin-bottom: 0;
    color: #666;
}

.recent-app-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: slideInUp 0.6s ease-out both;
}

.recent-app-card:nth-child(1) { animation-delay: 0.1s; }
.recent-app-card:nth-child(2) { animation-delay: 0.2s; }
.recent-app-card:nth-child(3) { animation-delay: 0.3s; }
.recent-app-card:nth-child(4) { animation-delay: 0.4s; }
.recent-app-card:nth-child(5) { animation-delay: 0.5s; }
.recent-app-card:nth-child(6) { animation-delay: 0.6s; }

.card.bg-light-job {
    background: rgba(255,255,255,0.95) !important;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    position: relative;
}

.card.bg-light-job::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(135deg, #5A9E2F 0%, #3f8215 100%);
}

.card.bg-light-job:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.card-body {
    position: relative;
    z-index: 1;
}

.btn-job {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    border: 2px solid transparent;
}



.job-details {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.cat-job {
    border-radius: 15px !important;
    font-weight: 500;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    transition: all 0.3s ease;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    .recent-apps-title {
        font-size: 1.5rem;
    }
    
    .card.bg-light-job:hover {
        transform: translateY(-4px);
    }
}
</style>

<section class="<%=bg%>">
    <div class="container px-4">
        <!-- Enhanced Header -->
        <div class="recent-apps-header">
            <h2 class="recent-apps-title"><%= t('ServiceRequestsRecentlyAppliedFor') %></h2>
        </div>
        
        <div class="row">
            <% const classes = ["bg-soft-danger", "bg-soft-base", "bg-soft-warning", "bg-soft-success", "bg-soft-info"];
                let limit = 6;
                if(ja.length < 6)
                    limit = ja.length;
                for(let i = 0; i < limit; i++){ %>
                
                <div class="col-lg-4 col-md-6 col-12 mt-1 pt-2 recent-app-card">
                    <div class="card border-0 bg-light-job rounded-job shadow-job">
                        <div class="card-body p-4">
                            <span class="btn btn-sm <%=classes[Math.floor(Math.random() * 5)]%> cat-job float-md-right mb-3 mb-sm-0"><%=ja[i].requestCategory %></span>
                            <h6><%=ja[i].requestTitle%></h6>
                            
                            <div class="mt-3">
                                <span class="d-block job-details">
                                    <b class="fa fa-money mr-2" aria-hidden="true"></b>
                                    <%= t('Budget') %>: <%=ja[i].budget%> <%=ja[i].currency%> <%=ja[i].convCurr%>
                                </span>
                                <span class="d-block job-details">
                                    <b class="fa fa-briefcase mr-2" aria-hidden="true"></b>
                                    <%= t('Deadline') %>: <%=ja[i].deadline%>
                                </span>
                                <span class="d-block job-details">
                                    <b class="fa fa-clock-o mr-2" aria-hidden="true"></b>
                                    <%= t('AppliedOn') %>: <%= ja[i].createdAt.getUTCMonth() + 1 %>/<%= ja[i].createdAt.getUTCDate()%>/<%= ja[i].createdAt.getUTCFullYear() %>
                                </span>
                            </div>
                            
                            <div class="mt-3 border-bottom pb-4 d-flex justify-content-center">
                                <a class="btn-job btn-primary-job-inv" href="/sr-details/<%=ja[i]._id%>">
                                    <b class="fa fa-eye mr-2"></b><%= t('ViewApplicationDetails') %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            <% } %>
        </div>
        
        <!-- View All Applications Link -->
        <% if (ja.length > 0) { %>
        <div class="row justify-content-center align-items-center mt-4">
            <div class="col-auto">
                <a href="/applications" class="btn-job btn-primary-job-inv">
                    <b class="fa fa-list mr-2"></b><%= t('ViewAllJobApps') || 'View All Applications' %>
                    <b class="fa fa-arrow-right ml-2"></b>
                </a>
            </div>
        </div>
        <% } %>
    </div>
</section>