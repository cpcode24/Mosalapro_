<div class="modal fade pro-modal" id="proSignModalCta" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div id="pills-register" class="adaptive-px">
        <div class="text-center ">
          <h6 class="title text text-center">Sign up as provider </h6> 
          </div>
          <div class="row mt-1 mb-1">
            <div class="col-lg-6 col-md-12 col-sm-12 col-12 p-2">
              <a class="btn btn-lg btn-block btn-primary p-2 mr-3" href="/auth/facebook" role="button" style="background-color: #4267b2; border: #fff;"
                  type="submit">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="mb-1 mr-2" viewBox="0 0 16 16">
                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/>
                  </svg> <%= t('ContinueWithFacebook') %></a>
              </div>
            <div class="col-lg-6 col-md-12 col-sm-12 col-12 mt-2">
              <a class="btn btn-lg btn-block btn-primary p-2" href="/auth/google" role="button" style="border: 1px gainsboro solid; background-color: #fff;"
                  type="submit">
                  <svg class="mr-2 mb-1" width="18" height="19" viewBox="0 0 18 19" xmlns="http://www.w3.org/2000/svg"><path d="M9 7.84363V11.307H13.8438C13.6365 12.428 12.9994 13.373 12.0489 14.0064V16.2534H14.9562C16.6601 14.6951 17.641 12.4029 17.641 9.67839C17.641 9.04502 17.5854 8.43176 17.4792 7.84865H9V7.84363Z" fill="#3E82F1"></path><path d="M9.00001 14.861C6.65394 14.861 4.67192 13.2876 3.96406 11.1714H0.955627V13.4937C2.43709 16.4142 5.48091 18.4198 9.00001 18.4198C11.432 18.4198 13.4697 17.6206 14.9562 16.2533L12.0489 14.0064C11.245 14.5443 10.2135 14.861 9.00001 14.861Z" fill="#32A753"></path><path d="M3.96404 5.45605H0.955617C0.348876 6.66246 0 8.02972 0 9.47238C0 10.915 0.348876 12.2823 0.955617 13.4887L3.96404 11.1714C3.78202 10.6335 3.6809 10.0605 3.6809 9.47238C3.6809 8.88426 3.78202 8.31122 3.96404 7.77336V5.45605Z" fill="#F9BB00"></path><path d="M0.955627 5.45597L3.96406 7.77327C4.67192 5.65703 6.65394 4.08368 9.00001 4.08368C10.3197 4.08368 11.5079 4.53608 12.4382 5.42078L15.0219 2.85214C13.4646 1.40948 11.427 0.52478 9.00001 0.52478C5.48091 0.52478 2.43709 2.53043 0.955627 5.45597Z" fill="#E74133"></path></svg>
                  <span style="color:black;"> <%= t('ContinueWithGoogle') %></span></a>
            </div>

          </div>
        <p class="text-center mb-1 mt-1">Or fill in information below.</p>

        <div  class="d-flex flex-column justify-content-center align-items-center mb-2"> 
          <span name="rMessagePro" id="repMessagePro" class="error_message "> </span>
        </div>
        
        <!--form  action="/register-pro" method="post"-->
          <input value="provider" class="d-none" name="userType" id="proviType" />
          <div class="form-group form-group-sm">
            <!-- Company Name input -->
            <div class="row mt-1">
              <div class="col mb-2">
                  <!-- Country input -->
                  <div class="form-outline  ">
                  <select class="form-control" oninput="this.className = 'form-control'" aria-label="Select Category" name="pCategory" id="proRegisterCategory" style="display: inline;">
                      <option value="">Select Category</option>

                      <% if(categories){ categories.forEach(cat=>{ %>
                        <option value="<%=cat.name %>"><%=cat.name %></option>
                      <% });} %>
                    </select>
                  </div>
              </div>
            </div>  
            <div class="row mt-1">
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 mb-2">
                  <!-- First name input -->
                  <div class="form-outline  ">
                      <input type="text" id="proRegisterFirstName" class="form-control" oninput="this.className = 'form-control'" placeholder="First Name" name="pFirstName"  required/>
                    </div>
              </div>
              <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                  <!-- Last name input -->
                  <div class="form-outline  ">
                      <input type="text" id="proRegisterLastName" class="form-control" oninput="this.className = 'form-control'" placeholder="Last Name" name="pLastName"  required/>
                  </div>
              </div>
            </div>
          
          <div class="row mt-1">
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 mb-2">
                  <!-- Email input -->
                  <div class="form-outline ">
                      <input type="email" id="proRegisterEmail" class="form-control" oninput="this.className = 'form-control'" placeholder="Email" name="pEmail"  pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" required/>
                  </div>
              </div>
              <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                  <!-- Phone input -->
                  <div class="form-outline ">
                      <input type="tel" id="proRegisterPhone" class="form-control" oninput="this.className = 'form-control'" placeholder="Phone Number" name="pPhone" pattern="/((\+*)((0[ -]*)*|(*))((\d{12})+|(\d{10})+))|\d{5}([- ]*)\d{6}/" required/>
                  </div>
              </div>
          </div>
          <!-- Address input -->
          <div class="row mt-1">
              <div class="col mb-2">
                  <div class="form-outline  ">
                      <input type="text" id="proRegisterAddress" class="form-control" placeholder="Address" name="pAddress"/>
                    </div>
              </div>
          </div>
          
          <div class="row mt-1">
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 mb-2">
                  <!-- Country input -->
                  <div class="form-outline  ">
                    <select name="country_p" id="country_pro" class="form-control" oninput="this.className = 'form-control'" aria-label="Select Country" style="display: inline;" required>
                      <option value="">Select Country</option>
                      <% countries.forEach(country => { %> 
                        <option value="<%= country.name %>"><%= country.name %></option>
                        <% }); %>
                    </select>
                  </div>
              </div>
              <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                  <!-- City input -->
                  <div class="form-outline  ">
                    <select class="form-control" aria-label="Select City"  oninput="this.className = 'form-control'" style="display: inline;" id="city_pro" name="city_p" required>
                        <option value="">Select City</option>
                      </select>
                  </div>
              </div>
          </div>

          <div class="row mt-1">
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 mb-2">
                  <!-- Password input -->
                      <div class="form-outline">
                          <input type="password" id="password-input-pro" class="form-control" oninput="this.className = 'form-control'" placeholder="Password" name="pPassword" aria-label="password" aria-describedby="password" autocomplete="off"required/>
                      </div>
              </div>
              <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                  <!-- Conifrm Password input -->
                  <div class="form-outline  ">
                      <input type="password" id="password-input-conf-pro" class="form-control" oninput="this.className = 'form-control'" placeholder="Confirm Password" name="pPasswordConf" autocomplete="off" required/>
                  </div>
              </div>
              
          </div>
          

            <div class="row  mt-1">
              <div class="col-lg-6 col-md-6 col-sm-12 col-12 d-flex justify-content-center">
                <!-- Checkbox -->
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" value="" id="termsCheckPro" unchecked required/>
                  <label class="form-check-label" for="termsCheck"> I accept the terms and conditions.</label>
                </div>
              </div>

              <div class="col-lg-6 col-md-6 col-sm-12 col-12 d-flex justify-content-center">
                <!-- Simple link -->
                <a href="/term-of-use">Read terms and conditions</a>
              </div>
            </div>

            <div class="row mt-1 ">
              
              <div class="col d-flex flex-column justify-content-center align-items-center">
                <div class=" justify-content-center">
                  <div class="g-recaptcha " data-sitekey="<%=recaptchaKey%>" data-callback="enableProRegBtn"></div>
                </div>
              </div>
            </div>

            <div class="row mt-3">
              <div class="col">
                  <!-- Submit button -->
                  <input type="submit" class="btn btn-block simple-btn big p-2 mb-1 " name="register-p" id="register-pro" onClick="validateAndRegisterP('<%=lang%>')" value="Register" disabled="disabled">
              </div>
            </div>
          </div>
        <!--/form-->
        <div  class="d-flex flex-column justify-content-center align-items-center"> 
          <span>Already have an account?  <a class="text-primary" href="#logModalCta" data-toggle="modal" data-dismiss="modal" data-caption-animate="fadeInUp">Sign In</a></span>
        </div>
      </div>
    </div>
  </div>
</div>





<script>
  function _(elt){return document.getElementById(elt); }
  _('country_pro').onchange = function(){
      filename = "./data/cities/" + _('country_pro').value +".json";
      $.getJSON(filename, function(data) {
        var items = [];
        items.push('<option value="">Select City</option>');
        $.each(data, function( key, val ) {
              items.push('<option value="' + val.name + '">' + val.name+ '</option>');
          });
        items.sort();
          _('city_pro').innerHTML = items;
      });}
  function enableProRegBtn(){
    document.getElementById("register_pro").disabled = false;
  }
</script>



