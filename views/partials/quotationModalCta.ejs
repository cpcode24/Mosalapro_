<div class="modal fade" id="quotationModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h5 class="mt-1 mb-1 text-center"><%=t('NewQuotation')%></h5>
            </div>
        <div class="form-container">
              <!--form action="#" class="contact-form form-validate" novalidate="novalidate"-->
                    <h6 class="mt-1 mb-3 text-center"> <%= job.requestTitle %></h6>
                    <span name="error" id="err_m"></span>
                    <div class="row mt-1">
                    <div class="col-lg-4 col-md-4 col-12">
                      <div class="form-group">
                          <input type="number" class="form-control" id="budget" name="budget" placeholder="Amount" >
                      </div>
                    </div>
                   
                    <div class="col-lg-4 col-md-4 col-12">
                      <div class="form-group">
                          <select name="budgetCurrency" id="budgetCurrency" class="form-control" >
                              <option value="<%=usr.currency%>"> <%=usr.currency%></option>
                              <% if(usr.currency != 'XAF') { %> <option value="XAF"> FCFA</option> <% } %>
                              <% if(usr.currency != 'USD') { %> <option value="USD"> USD </option> <% } %>
                              <% if(usr.currency != 'EUR') { %> <option value="XAF"> EUR </option> <% } %>
                              <% if(usr.currency != 'GBP') { %> <option value="GBP"> GBP </option> <% } %>
                          </select>
                      </div>
                  </div>

                  <div class="col-lg-4 col-md-4 col-12">
                    <div class="form-group">
                        <select name="budgetType" id="budgetType" class="form-control" onChange="onSelectQuoteType()">
                          <option value="Per hour"><%=t('PerHour')%></option>
                          <option value="Per project"><%=t('PerProject')%></option>
                        </select>
                    </div>
                  </div>

                    <div class="col-12">
                      <div class="form-group" id="timeOfCompletionField">
                        <label class="required-field" for="quotationDesc"><%=t('ApplicantProfileTimeOfCompletion')%></label>
                        <input type="number" min="1" id="timeOfCompletion" name="timeOfCompletion" class="form-control" />
                      </div>
                    </div>
                  
                    <div class="col-lg-12 col-md-12 col-12  ">
                    <div class="form-group">
                    <label class="required-field" for="quotationDesc"><%=t('Description')%></label>
                    <textarea class="form-control" id="quotationDesc" name="quotationDesc" rows="4" oninput="this.className = 'form-control'" placeholder="<%=t('PleaseProvideReason')%>"></textarea>
                    </div>
                    </div>
                    <div class="col d-inline mb-2">
                    <input type="button" onClick="sendQuotation('<%=job._id %>', '<%=owner._id %>')" name="submit" class="btn-job btn-primary-job hover-lift-light mt-4-ver" value="<%=t('Send')%>">
                    <input type="button" onClick="hideModal('#quotationModalCta')" data-dismiss="modal" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="<%=t('Cancel')%>">
                    </div>
                    </div>
                <!--/form-->
              </div>
  
          </div>
        </div>
      </div>
    </div>
    