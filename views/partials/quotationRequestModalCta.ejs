<div class="modal " id="quotationRequestModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header justify-content-center">
            <h5 class="text-center"><%= t('QuotationRequest') %></h5>
            </div>
        <div class="form-container">
              <!--form action="#" class="contact-form form-validate" novalidate="novalidate"-->
                    <span name="error" id="err_bm"></span>
                    <div class="row mt-1 mb-1">
                      <div class="col-lg-12 col-md-16 col-12">
                        <div class="form-group">
                          <label class="required-field" for="title"><%= t('ProjectTitle') %></label>

                            <input type="text" class="form-control" id="title" name="title" placeholder="<%= t('Title') %>"  oninput="this.className = 'form-control'" required>
                        </div>
                      </div>
                    
                    <div class="col-lg-12 col-md-12 col-12  ">
                        <div class="form-group">
                            <span id="attach_err_msg"></span>
                            <label for="qr-attachment" class="attach-btn">
                                <i class="fas fa-paperclip"></i> <%= t('AttachRequirementDocument') %>
                            </label>
                            <input id="qr-attachment" name="file" type="file" accept=
                            "application/msword, application/vnd.ms-excel, application/vnd.ms-powerpoint,
                            text/plain, application/pdf, image/*" style="display: none;" >
                            <pre class="output"><%= t('SelectedFile') %>:</pre>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-12  ">
                        <div class="form-group">
                        <label class="required-field" for="projectDesc"><%= t('Description') %></label>
                        <textarea class="form-control" id="projectDesc" minlength="20" name="quotationDesc" rows="3" oninput="this.className = 'form-control'" placeholder="<%= t('Description') %>" onkeyup="countChars()" aria-required></textarea>
                          <span class="" id="charCountScript">0/2000</span>
                      </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-12  ">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-12 mb-2">
                                <label class="required-field" for="requestCategory"><%= t('Category') %></label>
                                 <select class="form-control" id="requestCategory" name="requestCategory" oninput="this.className = 'form-control'" required>
                                    <option selected><%= t('SelectCategory') %></option>
                                    <% categories.forEach(cat => { %>
                                        <% if (lang === 'fr') { %>
                                          <option name="<%= cat.name %>" value="<%= cat.name %>"> <%= cat.translations.fr.name %></option>
                                        <% } else { %>
                                          <option name="<%= cat.name %>" value="<%= cat.name %>"> <%= cat.name %></option>
                                        
                                        <% } }); %>
                                  </select>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <label class="required-field" for="datepicker"><%= t('Deadline') %></label>
                                <div class="form-group">
                                    <div class="input-group">
                                        <input type="date" class="form-control" id="datepicker" name="requestDeadline" required oninput="this.className = 'form-control'">
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    
                    <div class="col d-flex justify-content-center mb-2">
                    <input type="submit" onClick="sendQuotationRequest('<%=pro._id%>')" name="submit" class="btn-job btn-primary-job hover-lift-light " value="<%= t('Send') %>" required>
                    <input type="button" onClick="hideModal('#quotationRequestModalCta')" data-dismiss="modal" name="cancel" class="btn-job btn-primary-job-inv-blue ml-3" value="<%= t('Cancel') %>">
                    </div>
                    </div>
                <!--/form-->
              </div>
  
          </div>
        </div>
      </div>
    </div>

<script>
    const output = document.querySelector(".output");
    const fileInput = document.querySelector("#qr-attachment");
    const attach_err_msg = document.getElementById("attach_err_msg");
    if(fileInput){
        fileInput.addEventListener("change", async () => {
            if(fileInput.files.length > 0){
                const fileSize = fileInput.files[0].size;
                const fileSizeInMB = fileSize / (1024*1024);
                if(fileSizeInMB > 10){
                    attach_err_msg.classList.add("error_message");
                    attach_err_msg.innerHTML = "<%= t('FileTooLargeError') %>";
                    await new Promise(r => setTimeout(r, 3500));
                    attach_err_msg.innerHTML = "";
                    return;
                }
            }
        for (const file of fileInput.files) {
            output.innerText += `\n${file.name}`;
        }
        });
    }

  // Set minimum date to today
  const today = new Date().toISOString().split('T')[0];
  const dateInput = document.getElementById('datepicker');
  dateInput.setAttribute('min', today);
  dateInput.addEventListener('click', () => {
        dateInput.showPicker();
    });



async function sendQuotationRequest(proId) {
  const title = document.getElementById("title");
  const requestCategory = document.getElementById("requestCategory");
  const requestDeadline = document.getElementById("datepicker");
  const description = document.getElementById("projectDesc");
  const file = document.querySelector("#qr-attachment").files.item(0);
  const msg = document.getElementById("err_bm");

  
  if(title.value.trim() == "" || title.value.trim().length < 2){
        title.className += " invalid";
        return;
  }
  if(description.value.trim() == "" || description.value.trim().length < 20){
        description.className += " invalid";
        return;
  }
  if(requestCategory.selectedIndex === 0){
    requestCategory.className += " invalid";
    return;
  } 
  if(requestDeadline.value.trim() == "" ){
        requestDeadline.className += " invalid";
        return;
  }
  const formData = new FormData();
  formData.append("requestTitle", title.value);
  formData.append("requestDescription", description.value);
  formData.append("requestCategory", requestCategory.value);
  formData.append("file", file);
  formData.append("deadline", requestDeadline.value);
  formData.append("providerId", proId);

  await fetch("/quotation-request", {
    method: "POST",
    body: formData,
  }).then(async (response) => {
    if (!response.ok) {
        msg.classList.add('error_message');
        msg.classList.remove("success_message");
        msg.innerHTML = "<%= t('ErrorOccurred') %>";
        await new Promise(r=> setTimeout(r, 2000));
        bootstrap.Modal.getInstance(document.getElementById('#quotationRequestModalCta')).hide();
        console.log("Error: ", response.json());
      }
    }) .then(async (data) => {
        msg.classList.remove('error_message');
        msg.classList.add("success_message");
        msg.innerHTML = "<%= t('QuotationRequestSentSuccess') %>";
        await new Promise(r=> setTimeout(r, 1200));
        $('#quotationRequestModalCta').modal('hide');
        msg.innerHTML = "";
        await socket.emit("pushNotification", {
                  "title": "<%= t('NewQuotationRequest') %>",
                  "content": "<%= t('ClientSentQuotationRequest') %>",
                  "userId": proId,
        "notifType": "pro"
        });
    });

}

async function _postData(url = '', data = {}) {
    const response = await fetch(url, {
        method: 'POST',
        mode: 'cors',
        cache: 'no-cache',
        credentials: 'same-origin',
        redirect: 'follow',
        referrerPolicy: 'no-referrer',
        headers: {
            "Content-type": "application/json; charset=UTF-8",
            'Accept': 'application/json'
        },
        body: JSON.stringify(data)
    });
    const contentType = response.headers.get("content-type");
    if (contentType && contentType.indexOf("application/json") !== -1) {
      return response.json();
    }else{ return response;}
}

function showModal(){
  $('#quotationRequestModalCta').modal('show');
}
function hideModal(id){
  $(id).modal('hide');
}

async function countChars(){
    const desc = document.getElementById("projectDesc");
    const charCount = document.getElementById("charCountScript");
    charCount.innerHTML = desc.value.length+"/2000";
}

</script>