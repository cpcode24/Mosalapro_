<style>
  .modal-dialog.modal-lg {
    max-height: 94vh;
    margin: 1rem auto;
  }
  
  .modal-content {
    max-height: 94vh;
    overflow-y: hidden;
  }
  
  .multi-step-form {
    overflow: hidden;
    position: relative;
  }
  
  .form-sections {
    display: flex;
    transition: transform 0.3s ease-in-out;
    width: 200%;
  }
  
  .form-section {
    width: 50%;
    flex-shrink: 0;
    padding: 0 15px;
  }
  
  .form-sections.slide-second {
    transform: translateX(-50%);
  }
  
  .step-indicator {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }
  
  .step {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: #e9ecef;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 5px;
    font-weight: bold;
    transition: all 0.3s ease;
  }
  
  .step.active {
    background-color: #007bff;
    color: white;
  }
  
  .step.completed {
    background-color: #28a745;
    color: white;
  }
  
  .step-connector {
    width: 50px;
    height: 2px;
    background-color: #e9ecef;
    margin-top: 14px;
    transition: background-color 0.3s ease;
  }
  
  .step-connector.active {
    background-color: #28a745;
  }
</style>
