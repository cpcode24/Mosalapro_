  <script>
    function nextSection(type) {

      const formSections = document.getElementById('formSections-' + type);
      const step1 = document.getElementById('step1-' + type);
      const step2 = document.getElementById('step2-' + type);
      const connector = document.getElementById('connector1-' + type);
      
      // Add slide animation
      formSections.classList.add('slide-second');
      
      // Update step indicators
      step1.classList.remove('active');
      step1.classList.add('completed');
      step2.classList.add('active');
      connector.classList.add('active');
    }
    
    function previousSection(type) {
      const formSections = document.getElementById('formSections-' + type);
      const step1 = document.getElementById('step1-' + type);
      const step2 = document.getElementById('step2-' + type);
      const connector = document.getElementById('connector1-' + type);
      
      // Remove slide animation
      formSections.classList.remove('slide-second');
      
      // Update step indicators
      step1.classList.add('active');
      step1.classList.remove('completed');
      step2.classList.remove('active');
      connector.classList.remove('active');
    }
    
    // reCAPTCHA callback functions are defined in registerUser.js and registerProvider.js
    
    // Category validation on keyup
    function validateCategoryOnKeyup(input) {
      const value = input.value.trim();
      const rMessagePro = document.getElementById("rMessagePro");
      
      // Clear previous error message
      rMessagePro.textContent = '';
      
      if (value.length > 0) {
        // Make API call to check category
        fetch('/api/search/categories?q=' + encodeURIComponent(value))
          .then(response => response.json())
          .then(data => {
            const isValid = data.some(category => 
              category.toLowerCase() === value.toLowerCase()
            );
            
            if (!isValid) {
              input.classList.add('invalid');
              rMessagePro.textContent = '<%= t("InvalidCategory") %>';
            } else {
              input.classList.remove('invalid');
            }
            validateProviderStep1();
          })
          .catch(error => {
            console.error('Error validating category:', error);
          });
      }
    }
    
    // Email and phone validation function
    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }
    
    function isValidPhone(phone) {
      // Remove non-digit characters except +
      const cleaned = phone.replace(/[^\d+]/g, '');
      // Check if it's a valid phone number (7+ digits, may start with +)
      return /^\+?[1-9]\d{6,14}$/.test(cleaned);
    }
    
    function validateEmailOrPhone(input) {
      const value = input.value.trim();
      const hint = input.id.includes('pRegister') ? 
        document.getElementById('pEmailPhoneHint') : 
        document.getElementById('emailPhoneHint');
      
      if (!value) {
        hint.textContent = '<%= t("EnterEmailOrPhone") %>';
        hint.className = 'form-text text-muted';
        return;
      }
      
      const isEmail = isValidEmail(value);
      const isPhone = isValidPhone(value);
      
      if (isEmail) {
        hint.textContent = '<%= t("EmailDetected") %>';
        hint.className = 'form-text text-success';
      } else if (isPhone) {
        hint.textContent = '<%= t("PhoneDetected") %>';
        hint.className = 'form-text text-success';
      } else {
        hint.textContent = `<%= t('InvalidEmailOrPhone') %>`;
        hint.className = 'form-text text-danger';
      }
    }
    
    // Form validation functions
    function validateUserStep1() {
      const firstName = document.getElementById("registerFirstName").value.trim();
      const lastName = document.getElementById("registerLastName").value.trim();
      const emailOrPhone = document.getElementById("registerEmailOrPhone").value.trim();
      const termsCheck = document.getElementById("termsCheck").checked;
      
      const isValidEmailOrPhone = isValidEmail(emailOrPhone) || isValidPhone(emailOrPhone);
      
      const isValid = firstName.length >= 2 && 
                     lastName.length >= 2 && 
                     isValidEmailOrPhone && 
                     termsCheck;
      
      const nextBtn = document.querySelector('button[onclick="nextSection(\'u\')"]');
      if (nextBtn) {
        nextBtn.disabled = !isValid;
        nextBtn.style.opacity = isValid ? '1' : '0.5';
      }
    }
    
    function validateProviderStep1() {
      const category = document.getElementById("pRegisterCategory").value.trim();
      const firstName = document.getElementById("pRegisterFirstName").value.trim();
      const lastName = document.getElementById("pRegisterLastName").value.trim();
      const emailOrPhone = document.getElementById("pRegisterEmailOrPhone").value.trim();
      const termsCheckP = document.getElementById("termsCheckProvider").checked;
      const isCatClassInvalid = document.getElementById("pRegisterCategory").classList.contains('invalid');
      const rMessagePro = document.getElementById("rMessagePro");
      const isValidCategory = category.length > 0 && category !== '<%= t("RegisterSelectCategory") %>' && !isCatClassInvalid;
      const isValidEmailOrPhone = isValidEmail(emailOrPhone) || isValidPhone(emailOrPhone);
      
      // Clear previous error message
      rMessagePro.textContent = '';
      
      if (category.length > 0 && !isValidCategory) {
        rMessagePro.textContent = '<%= t("InvalidCategory") || "Please select a valid category" %>';
      }
      
      const isValid = category.length > 0 &&
                     firstName.length >= 2 && 
                     lastName.length >= 2 && 
                     isValidEmailOrPhone && 
                     isValidCategory &&
                     termsCheckP;
      
      const nextBtn = document.querySelector('button[onclick="nextSection(\'p\')"]');
      if (nextBtn) {
        nextBtn.disabled = !isValid;
        nextBtn.style.opacity = isValid ? '1' : '0.5';
      }
    }
    
    // Autocomplete initialization
    function setupAutoComplete() {
      // Check if AutoComplete class is loaded
      if (typeof AutoComplete === 'undefined') {
        console.error('AutoComplete class not loaded');
        return;
      }

      // User registration autocomplete
      const countryInput = document.getElementById('country');
      const cityInput = document.getElementById('city');
      
      if (countryInput) {
        new AutoComplete({
          inputId: 'country',
          apiUrl: '/api/search/countries',
          minLength: 1,
          placeholder: `<%= t('Country') %>`,
          noResultsText: '<%= t("NoCountries") || "No countries found" %>',
          debounceDelay: 300,
          onSelect: function(item, input) {
            // Clear city when country changes
            if (cityInput) {
              cityInput.value = '';
              cityInput.removeAttribute('data-value');
            }
          }
        });
      }

      if (cityInput) {
        new AutoComplete({
          inputId: 'city',
          apiUrl: '/api/search/cities',
          minLength: 1,
          placeholder: `<%= t('City') %>`,
          noResultsText: '<%= t("NoCities") || "No cities found" %>',
          dependsOn: 'country',
          debounceDelay: 300
        });
      }

      // Provider registration autocomplete
      const categoryInputP = document.getElementById('pRegisterCategory');
      const countryInputP = document.getElementById('country_p');
      const cityInputP = document.getElementById('city_p');

      if (categoryInputP) {
        new AutoComplete({
          inputId: 'pRegisterCategory',
          apiUrl: '/api/search/categories',
          minLength: 1,
          placeholder: `<%= t('Category') %>`,
          noResultsText: `<%= t("NoCategories") || "No categories found" %>`,
          debounceDelay: 300,
          onSelect: function(item, input) {
            input.classList.remove('invalid');
            validateProviderStep1();
          },
          onNoMatch: function(input) {
            input.classList.add('invalid');
            validateProviderStep1();
          }
        });
      }

      if (countryInputP) {
        new AutoComplete({
          inputId: 'country_p',
          apiUrl: '/api/search/countries',
          minLength: 1,
          placeholder: `<%= t('Country') %>`,
          noResultsText: '<%= t("NoCountries") || "No countries found" %>',
          debounceDelay: 300,
          onSelect: function(item, input) {
            // Clear city when country changes
            if (cityInputP) {
              cityInputP.value = '';
              cityInputP.removeAttribute('data-value');
            }
          }
        });
      }

      if (cityInputP) {
        new AutoComplete({
          inputId: 'city_p',
          apiUrl: '/api/search/cities',
          minLength: 1,
          placeholder: `<%= t('City') %>`,
          noResultsText: '<%= t("NoCities") || "No cities found" %>',
          dependsOn: 'country_p',
          debounceDelay: 300
        });
      }
    }

    // Initialize validation when document is ready
    document.addEventListener('DOMContentLoaded', function() {
      // Setup autocomplete functionality
      setupAutoComplete();
      
      // User registration validation
      const userFields = ['registerFirstName', 'registerLastName', 'registerEmailOrPhone'];
      userFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('input', validateUserStep1);
        }
      });
      
      const termsCheck = document.getElementById('termsCheck');
      if (termsCheck) {
        termsCheck.addEventListener('change', validateUserStep1);
      }
      
      // Provider registration validation
      const providerFields = ['pRegisterCategory', 'pRegisterFirstName', 'pRegisterLastName', 'pRegisterEmailOrPhone'];
      providerFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('input', validateProviderStep1);
        }
      });
      
      const termsCheckP = document.getElementById('termsCheckProvider');
      if (termsCheckP) {
        termsCheckP.addEventListener('change', validateProviderStep1);
      }
      
      // Initial validation
      validateUserStep1();
      validateProviderStep1();
    });
  </script>

