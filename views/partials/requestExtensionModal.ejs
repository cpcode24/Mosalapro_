<div class="modal fade" id="requestExtensionModalCta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
      <div class="modal-dialog" role="document">
        <div class="modal-content pt-1 mb-1">
          <div class="modal-header mt-1">
            <h5 class="mt-1 mb-1 text-center" id="titl"><%=t('RequestExtension')%></h5>
            </div>
        <div class="form-container">
              <!--form action="#" class="contact-form form-validate" novalidate="novalidate"-->
                    <span name="error" id="err_bm" ></span>
                    <div class="row mt-1">
                    <div class="col-lg-12 col-md-12 col-12">
                        <label class="required-field" for="quotationDesc"><%=t('NewDeadline')%></label>
                        <div class="form-group ">
                            <div class="input-group">
                                        <input type="date" class="form-control" id="datepicker2" name="requestDeadline2" required oninput="this.className = 'form-control'">
                                       
                                    </div>
                        </div>
                    </div>
                  
                    <div class="col-lg-12 col-md-12 col-12  ">
                    <div class="form-group">
                    <label class="required-field" for="reason"><%=t('ReasonForExtension')%></label>
                    <textarea class="form-control" id="reason" name="quotationDesc" rows="4" oninput="this.className = 'form-control'" placeholder="Description"></textarea>
                    </div>
                    </div>
                    <div class="col-12">
                      <div class="d-flex justify-content-center align-items-center mt-4 mb-3">
                          <button type="button" onClick="requestNewDeadline('<%=customer._id%>')" class="btn btn-primary-job px-4 mr-3" style="min-width: 100px;">Send</button>
                          <button type="button" onClick="hideModal('#requestExtensionModalCta')" data-dismiss="modal" class="btn btn-primary-job-inv-blue px-4" style="min-width: 100px;">Cancel</button>
                      </div>
                    </div>
                    </div>
                <!--/form-->
              </div>
  
          </div>
        </div>
      </div>
    </div>
    

<script>
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('datepicker2').setAttribute('min', today);

  function requestNewDeadline(userId) {
  let params = new URLSearchParams(document.location.search);
  let proId = params.get("id");
  let bookingId = params.get("b");
  const msg = document.getElementById("err_bm");

  const newDeadline = document.getElementById("datepicker2").value;
  const reason = document.getElementById("reason").value;

  if(newDeadline === "" || reason.trim() === ""){
      msg.classList.remove('success_message');
      msg.classList.add('error_message');
      msg.innerHTML = `<%= t('PleaseFillAllFields') %>`;
      return;
  }

  requestData = {
    newDeadline: newDeadline,
    reason: reason,
    bookingId: bookingId,
  };

  _postData('/request/new-deadline', requestData )
  .then(async json => {
    try{
        if(json.status == 200){
          msg.classList.remove('error_message');
          msg.classList.add('success_message');
          msg.innerHTML = "Deadline extension request successfully sent!";
          await new Promise(r => setTimeout(r, 1700));
          $('#requestExtensionModalCta').modal('hide'); 
          // var lnk = location.href.split("/");
          // var baseLnk = lnk[0]+"//"+lnk[2];
          // var socket = io(baseLnk, { transports: ['websocket', 'polling', 'flashsocket'], 'force new connection': true });
        
          await socket.emit("pushNotification", {
                  "title": "New deadline extension request",
                  "content": "Service provider has requested a new deadline for your service request.",
                  "userId": userId,
                  "notifType": "user"
              });
        }
        else if(json.status == 402){
            msg.classList.remove('success_message');
            msg.classList.add('error_message');
            msg.innerHTML = "An error occured. Please try again.";
            await new Promise(r => setTimeout(r, 1500));
            $('#requestExtensionModalCta').hide();
            $('.modal-backdrop').hide();
        }
        else{
          msg.classList.remove('success_message');
            msg.classList.add('error_message');
            msg.innerHTML = "An error occured. Please try again.";
            await new Promise(r => setTimeout(r, 1500));
            $('#requestExtensionModalCta').hide();
            $('.modal-backdrop').hide();
        }
  }catch(error){
        msg.classList.remove('success_message');
        msg.classList.add('error_message');
        msg.innerHTML = "An error occured: "+error;
        await new Promise(r => setTimeout(r, 2000));
        $('#requestExtensionModalCta').hide();
        $('.modal-backdrop').hide();
    }
  });

}

</script>