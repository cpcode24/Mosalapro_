                <input type="text" placeholder="<%= t('RatePlaceholder') %>" class="form-control">
                
            </div>


    <div class="col-md-4">

        <input type="text" class="form-control" id="country_search" name="country_search" placeholder="<%= t('Country') %>"/>
        
    </div>
    

    <div class="col-md-4">

        <input type="text" class="form-control" id="city_search" name="city_search" placeholder="<%= t('SelectCity') %>"/>
        
    </div>
    
    </div>

    </div>
    </div>


                </div>    
            </div>

    </div>

