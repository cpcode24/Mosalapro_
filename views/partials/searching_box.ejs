                        </div>
                    </div>

                    <div class="col-lg-8 col-md-8 col-sm-12">
                        <div class="input-group">
                            <input type="search" class="form-control search-input rounded " name="search" placeholder="<%= t('KeywordSearchPlaceholder') %>" aria-label="Search" aria-describedby="search-addon" />
