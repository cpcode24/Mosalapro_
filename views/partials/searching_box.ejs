</div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize autocomplete for search box elements
    if (typeof AutoComplete !== 'undefined') {
        // Category autocomplete
        const categoryInput = document.getElementById('selected_category');
        if (categoryInput) {
            new AutoComplete({
                inputId: 'selected_category',
                apiUrl: '/api/search/categories',
                minLength: 1,
                placeholder: `<%= t('Category') %>`,
                noResultsText: '<%= t("NoCategories") || "No categories found" %>',
                debounceDelay: 300
            });
        }

        // Country autocomplete
        const countryInput = document.getElementById('country_search');
        if (countryInput) {
            new AutoComplete({
                inputId: 'country_search',
                apiUrl: '/api/search/countries',
                minLength: 1,
                placeholder: `<%= t('Country') %>`,
                noResultsText: '<%= t("NoCountries") || "No countries found" %>',
                debounceDelay: 300,
                onSelect: function(item, input) {
                    // Clear city when country changes
                    const cityInput = document.getElementById('city_search');
                    if (cityInput) {
                        cityInput.value = '';
                        cityInput.removeAttribute('data-value');
                    }
                }
            });
        }

        // City autocomplete
        const cityInput = document.getElementById('city_search');
        if (cityInput) {
            new AutoComplete({
                inputId: 'city_search',
                apiUrl: '/api/search/cities',
                minLength: 1,
                placeholder: `<%= t('City') %>`,
                noResultsText: '<%= t("NoCities") || "No cities found" %>',
                dependsOn: 'country_search',
                debounceDelay: 300
            });
        }
    }
});
</script>

