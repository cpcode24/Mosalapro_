  <!-- Portfolio Styles -->
  <style>
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .portfolio-item {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 10px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .portfolio-item:hover {
      box-shadow: 0 8px 25px rgba(0,0,0,0.1);
      transform: translateY(-2px);
    }

    .portfolio-item-header {
      display: flex;
      justify-content: between;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .portfolio-category {
      background: linear-gradient(45deg,  #a2e17b, #3d7a18);
      color: white;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 500;
      position: absolute;
      top: 15px;
      right: 15px;
    }

    .portfolio-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 8px;
      margin-top: 2rem;
      line-height: 1.4;
    }

    .portfolio-description {
      color: #666;
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 15px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .portfolio-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      padding-top: 15px;
      border-top: 1px solid #f0f0f0;
    }

    .portfolio-budget {
      font-weight: 600;
      color: #28a745;
      font-size: 1rem;
    }

    .portfolio-date {
      color: #888;
      font-size: 0.85rem;
    }

    .portfolio-rating {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 10px;
    }

    .portfolio-rating .rating-stars {
      color: #ffd700;
    }

    .portfolio-rating .rating-text {
      color: #666;
      font-size: 0.85rem;
    }

    .portfolio-filters .nav-pills .nav-link {
      border-radius: 20px;
      margin-right: 10px;
      transition: all 0.3s ease;
    }

    .portfolio-filters .nav-pills .nav-link.active {
      background: linear-gradient(45deg, #5A9E2F, #4c9a1c);
    }

    .portfolio-type-badge {
      position: absolute;
      top: 15px;
      left: 15px;
      background: rgba(0, 123, 255, 0.1);
      color: #007bff;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
    }

    .portfolio-client {
      color: #666;
      font-size: 0.85rem;
      margin-bottom: 5px;
    }

    .portfolio-deliverables {
      margin-top: 15px;
    }

    .portfolio-files {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    .file-badge {
      background: #f8f9fa;
      color: #495057;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .file-badge:hover {
      background: #007bff;
      color: white;
      text-decoration: none;
    }

    .empty-state i {
      opacity: 0.5;
    }

    @media (max-width: 768px) {
      .portfolio-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      
      .portfolio-item {
        padding: 15px;
      }
    }
  </style>


  <!-- Portfolio JavaScript -->
  <script>
    let currentCategory = 'all';
    let portfolioData = null;
    let currentPage = 1;
    const itemsPerPage = 3;

    document.addEventListener('DOMContentLoaded', function() {
      const providerId = '<%= pro._id %>';
      if (providerId) {
        loadPortfolio(providerId);
      }

      // Filter tab click handlers
      document.addEventListener('click', function(e) {
        if (e.target.matches('.portfolio-filter-tab') || e.target.closest('.portfolio-filter-tab')) {
          e.preventDefault();
          e.stopPropagation();
          
          const target = e.target.matches('.portfolio-filter-tab') ? e.target : e.target.closest('.portfolio-filter-tab');
          const category = target.dataset.category;
          
          // Update active tab
          document.querySelectorAll('.portfolio-filter-tab').forEach(tab => {
            tab.classList.remove('active');
          });
          target.classList.add('active');
          
          // Filter portfolio
          filterPortfolio(category);
          
          return false;
        }

        // Portfolio item click handler
        if (e.target.closest('.portfolio-item')) {
          const itemId = e.target.closest('.portfolio-item').dataset.itemId;
          if (itemId) {
            showPortfolioDetails(itemId);
          }
        }
      });

      // Load more button
      document.getElementById('load-more-btn')?.addEventListener('click', function() {
        currentPage++;
        displayPortfolioItems(portfolioData.portfolioItems, false);
      });

      // Additional event handler specifically for portfolio filter tabs
      document.getElementById('portfolio-filter-tabs')?.addEventListener('click', function(e) {
        if (e.target.matches('a.portfolio-filter-tab')) {
          e.preventDefault();
          e.stopPropagation();
          
          const category = e.target.dataset.category;
          
          // Update active tab
          document.querySelectorAll('.portfolio-filter-tab').forEach(tab => {
            tab.classList.remove('active');
          });
          e.target.classList.add('active');
          
          // Filter portfolio
          filterPortfolio(category);
          
          return false;
        }
      });
    });

    function loadPortfolio(providerId) {
      fetch(`/api/provider/${providerId}/portfolio`)
        .then(response => response.json())
        .then(data => {
          portfolioData = data;
          displayPortfolio(data);
          setupCategoryFilters(data.stats.categories);
        })
        .catch(error => {
          console.error('Error loading portfolio:', error);
          showPortfolioError();
        });
    }

    function displayPortfolio(data) {
      document.getElementById('portfolio-loading').style.display = 'none';
      
      if (data.portfolioItems && data.portfolioItems.length > 0) {
        document.getElementById('portfolio-grid').style.display = 'block';
        document.getElementById('portfolio-count').textContent = `${data.totalItems} <%= t('Projects') %>`;
        document.getElementById('portfolio-rating').textContent = `⭐ (<%=pro.ratingCount%>)`;
        
        displayPortfolioItems(data.portfolioItems, true);
      } else {
        document.getElementById('portfolio-empty').style.display = 'block';
      }
    }

    function displayPortfolioItems(items, reset = true) {
      const container = document.getElementById('portfolio-grid');
      if (reset) {
        container.innerHTML = '';
        currentPage = 1;
      }
      
      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const itemsToShow = items.slice(start, end);
      
      itemsToShow.forEach(item => {
        const portfolioElement = createPortfolioElement(item);
        container.appendChild(portfolioElement);
      });
      
      // Show/hide load more button
      const loadMoreContainer = document.getElementById('load-more-container');
      if (end < items.length) {
        loadMoreContainer.style.display = 'block';
      } else {
        loadMoreContainer.style.display = 'none';
      }
    }

    function createPortfolioElement(item) {
      const div = document.createElement('div');
      div.className = 'portfolio-item';
      div.dataset.itemId = item.id;
      div.style.cursor = 'pointer';
      
      const completedDate = new Date(item.completedDate).toLocaleDateString();
      const ratingHtml = item.rating ? 
        `<div class="portfolio-rating">
          <div class="rating-stars">${getStarHTML(item.rating.score)}</div>
          <span class="rating-text">"${item.rating.comment || item.rating.title || 'Great work!'}"</span>
        </div>` : '';
      
      const filesHtml = (item.files || []).concat(item.deliveryFiles || [])
        .filter(file => file)
        .slice(0, 3)
        .map(file => `<a href="${file}" class="file-badge" target="_blank">📎 View File</a>`)
        .join('');
      
      div.innerHTML = `
        <div class="portfolio-type-badge">${item.type}</div>
        <div class="portfolio-category">${item.category || 'General'}</div>
        <div class="portfolio-item-content">
          <h6 class="portfolio-title">${item.title}</h6>
          <p class="portfolio-client">Client: ${item.clientName}</p>
          <p class="portfolio-description">${item.description}</p>
          
          <div class="portfolio-meta">
            <div class="portfolio-budget">$${item.budget} ${item.currency}</div>
            <div class="portfolio-date">${completedDate}</div>
          </div>
          
          ${ratingHtml}
          
          ${filesHtml ? `<div class="portfolio-deliverables">
            <small class="text-muted">Deliverables:</small>
            <div class="portfolio-files">${filesHtml}</div>
          </div>` : ''}
        </div>
      `;
      
      return div;
    }

    function setupCategoryFilters(categories) {
      const container = document.getElementById('category-tabs-container');
      container.innerHTML = '';
      
      categories.forEach(category => {
        const li = document.createElement('li');
        li.className = 'nav-item';
        li.innerHTML = `<a class="nav-link portfolio-filter-tab" data-category="${category.name}" href="#">${category.name} (${category.count})</a>`;
        container.appendChild(li);
      });
    }

    function filterPortfolio(category) {
      if (!portfolioData) return;
      
      currentCategory = category;
      const filteredItems = category === 'all' 
        ? portfolioData.portfolioItems 
        : portfolioData.portfolioItems.filter(item => item.category === category);
      
      displayPortfolioItems(filteredItems, true);
    }

    function showPortfolioDetails(itemId) {
      const item = portfolioData.portfolioItems.find(i => i.id === itemId);
      if (!item) return;
      
      const modalBody = document.getElementById('portfolioModalBody');
      const completedDate = new Date(item.completedDate).toLocaleDateString();
      const createdDate = new Date(item.createdDate).toLocaleDateString();
      
      const ratingHtml = item.rating ? 
        `<div class="mb-3">
          <h6>Client Rating</h6>
          <div class="d-flex align-items-center">
            <div class="rating-stars mr-2">${getStarHTML(item.rating.score)}</div>
            <span>(${item.rating.score}/5)</span>
          </div>
          ${item.rating.comment ? `<p class="mt-2 text-muted">"${item.rating.comment}"</p>` : ''}
        </div>` : '';
      
      const filesHtml = (item.files || []).concat(item.deliveryFiles || [])
        .filter(file => file)
        .map(file => `<a href="${file}" class="btn btn-sm btn-outline-primary mr-2 mb-2" target="_blank">📎 Download File</a>`)
        .join('');
      
      modalBody.innerHTML = `
        <div class="row">
          <div class="col-md-8">
            <h4>${item.title}</h4>
            <p class="text-muted mb-3">Client: ${item.clientName} | Category: ${item.category || 'General'}</p>
            <p>${item.description}</p>
            
            ${item.deliveryComment ? `
              <div class="mb-3">
                <h6>Delivery Notes</h6>
                <p>${item.deliveryComment}</p>
              </div>
            ` : ''}
            
            ${ratingHtml}
            
            ${filesHtml ? `
              <div class="mb-3">
                <h6>Project Files</h6>
                <div>${filesHtml}</div>
              </div>
            ` : ''}
          </div>
          <div class="col-md-4">
            <div class="card">
              <div class="card-body">
                <h6 class="card-title">Project Details</h6>
                <p><strong>Budget:</strong> $${item.budget} ${item.currency}</p>
                <p><strong>Type:</strong> ${item.budgetType}</p>
                <p><strong>Started:</strong> ${createdDate}</p>
                <p><strong>Completed:</strong> ${completedDate}</p>
                <p><strong>Status:</strong> <span class="badge badge-success">Completed</span></p>
              </div>
            </div>
          </div>
        </div>
      `;
      
      $('#portfolioModal').modal('show');
    }

    function getStarHTML(rating) {
      const fullStars = Math.floor(rating);
      const hasHalfStar = rating % 1 >= 0.5;
      let html = '';
      
      for (let i = 0; i < fullStars; i++) {
        html += '<i class="fas fa-star"></i>';
      }
      
      if (hasHalfStar) {
        html += '<i class="fas fa-star-half-alt"></i>';
      }
      
      const emptyStars = 5 - Math.ceil(rating);
      for (let i = 0; i < emptyStars; i++) {
        html += '<i class="far fa-star"></i>';
      }
      
      return html;
    }

    function showPortfolioError() {
      document.getElementById('portfolio-loading').style.display = 'none';
      document.getElementById('portfolio-empty').style.display = 'block';
      document.querySelector('#portfolio-empty .empty-state h6').textContent = '<%= t("ErrorLoadingPortfolio") || "Error Loading Portfolio" %>';
      document.querySelector('#portfolio-empty .empty-state p').textContent = '<%= t("ErrorLoadingPortfolioDesc") || "Please try again later." %>';
    }

    // Load provider availability (public view)
    async function loadProviderAvailability() {
      const providerId = '<%= pro._id %>';
      try {
        const response = await fetch(`/api/availability/provider/${providerId}`);
        const data = await response.json();

        if (data.success && data.availabilities.length > 0) {
          displayProviderAvailability(data.availabilities);
        } else {
          document.getElementById('providerAvailabilityDisplay').innerHTML = `
            <div class="text-center text-muted py-4">
              <i class="fas fa-calendar-times fa-2x mb-2"></i>
              <p>This provider has not set their availability yet.</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading availability:', error);
        document.getElementById('providerAvailabilityDisplay').innerHTML = `
          <div class="alert alert-warning">
            Could not load availability information.
          </div>
        `;
      }
    }

    function displayProviderAvailability(availabilities) {
      const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

      // Group recurring by day
      const recurring = availabilities.filter(a => a.type === 'recurring');
      const specific = availabilities.filter(a => a.type === 'specific');

      let html = '';

      // Display recurring schedule
      if (recurring.length > 0) {
        html += '<h6 class="mb-3">Regular Hours</h6>';
        html += '<div class="mb-4">';

        const byDay = {};
        recurring.forEach(slot => {
          if (!byDay[slot.dayOfWeek]) byDay[slot.dayOfWeek] = [];
          byDay[slot.dayOfWeek].push(slot);
        });

        for (let day = 0; day <= 6; day++) {
          if (byDay[day]) {
            html += `
              <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <strong>${dayNames[day]}</strong>
                <div>
                  ${byDay[day].map(slot => `
                    <span class="badge badge-success mr-1">
                      <i class="far fa-clock"></i> ${formatTime(slot.startTime)} - ${formatTime(slot.endTime)}
                    </span>
                  `).join('')}
                </div>
              </div>
            `;
          }
        }

        html += '</div>';
      }

      // Display specific dates (upcoming only)
      if (specific.length > 0) {
        const upcoming = specific.filter(s => new Date(s.date) >= new Date());
        if (upcoming.length > 0) {
          html += '<h6 class="mb-3 mt-3">Special Hours</h6>';
          html += '<div>';

          upcoming.slice(0, 5).forEach(slot => {
            const date = new Date(slot.date);
            html += `
              <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <span>${date.toLocaleDateString('en-US', {weekday: 'long', month: 'long', day: 'numeric'})}</span>
                <span class="badge badge-info">
                  <i class="far fa-clock"></i> ${formatTime(slot.startTime)} - ${formatTime(slot.endTime)}
                </span>
              </div>
            `;
          });

          html += '</div>';
        }
      }

      document.getElementById('providerAvailabilityDisplay').innerHTML = html;
    }

    function formatTime(time24) {
      const [hours, minutes] = time24.split(':');
      const hour = parseInt(hours);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const hour12 = hour % 12 || 12;
      return `${hour12}:${minutes} ${ampm}`;
    }

    // Load availability when page loads
    if (document.getElementById('providerAvailabilityDisplay')) {
      document.addEventListener('DOMContentLoaded', function() {
        loadProviderAvailability();
      });
    }
  </script>

