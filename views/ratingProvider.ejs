          <!-- <b class="fa-star-half-o big"></b> -->
      <p class=" mb-1 px-3">
      Please provide feedback about the service you received from <%= proName %> for the service <b><%=jobTitle%></b>.
      </p>
      <!--form action="/submit-rating" method="post"-->
        <div  class="d-flex flex-column justify-content-center align-items-center"> 
            <span name="e_message" id="e_message" class="error_message "> </span>
        </div>
        <div class="row mt-2 d-flex px-3 justify-content-center">
            <div class="col-12 col-lg-4 col-md-4 rating-item-text "> Rating :</div>
            <div class="col-12 col-lg-8 col-md-8 "> 
                <div class="rating d-flex align-items-center">

                    <input type="radio" name="rating" value="-1" id="5" onclick="setValue(5)"><label for="5">☆</label>
                    <input type="radio" name="rating" value="-1" id="4" onclick="setValue(4)"><label for="4">☆</label>
                    <input type="radio" name="rating" value="-1" id="3" onclick="setValue(3)"><label for="3">☆</label>
                    <input type="radio" name="rating" value="-1" id="2" onclick="setValue(2)"><label for="2">☆</label>
                    <input type="radio" name="rating" value="-1" id="1" onclick="setValue(1)"><label for="1">☆</label>
                </div>
            </div>
        </div>
        <!--div class="row mt-2 d-flex px-3">
          <div class="col-12 col-lg-4 col-md-4 rating-item-text">Title: </div><div class="col-12 col-lg-7 col-md-7"> <input type="text" maxlength="200" class="form-control has-success px-2" name="ratingTitle" id="ratingTitle" /></div>
        </div-->
        <div class="row mt-2 d-flex px-3">
            <div class="col-12 col-lg-4 col-md-4 rating-item-text">Comments: </div><div class="col-12 col-lg-7 col-md-7"> <textarea maxlength="20000" rows="4" class="form-control has-success px-2" name="ratingComment" id="ratingComment" placeholder="How was the service provided by <%=proName%> ?"></textarea></div>
        </div>
        
        <!-- Privacy Controls for Friend Reviews -->
        <div class="row mt-3 d-flex px-3">
            <div class="col-12">
                <div class="card p-3" style="background-color: #f8f9fa;">
                    <h6 class="mb-3"><i class="fab fa-facebook-f text-primary mr-2"></i>Review Visibility</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="reviewVisibility" id="publicReview" value="public" checked>
                        <label class="form-check-label" for="publicReview">
                            <strong>Public</strong> - Everyone can see this review
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="reviewVisibility" id="friendsOnlyReview" value="friendsOnly">
                        <label class="form-check-label" for="friendsOnlyReview">
                            <strong>Facebook Friends Only</strong> - Only your Facebook friends can see this review
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reviewVisibility" id="privateReview" value="private">
                        <label class="form-check-label" for="privateReview">
                            <strong>Private</strong> - Keep this review private (only you and the provider can see it)
                        </label>
                    </div>
                </div>
            </div>
        </div>
        
        <button type="submit" class="btn button-primary btn-lg w-100 hover-lift-light mt-4-ver" name="submitRating" id="submitRating" value="submit rating" onclick="submitRating('<%=proId%>', '<%=jobId%>', '<%=jobTitle%>')"> Submit Rating</button>
      <!--form-->
        
     
      </div>
      </div>
      </p>
      </div>
      </div>
        <div class="row-service d-none mt-4" id="rating-success">
            <div class="col mt-4 mb-3 py-4" >
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <h3 class="mx-auto"> Your rating has been successfully submitted!</h3>
                    <img  src="/images/done.png" class="service-image p-4 mx-auto"
                        alt="image">
                    <h6 class="text-light mt-2 pr-4 mt-4 mx-auto">Your rating and feedback have been submitted. Thank you for helping us provide a better experience.</h6>
                </div>
            </div>
        </div>
    </div>
</section>


<script src="js/handleRating.js"></script>
<%- include('partials/footer') %>