<%- include('partials/header') %>
<style>
/* Initial tab visibility handled by JavaScript */
.tab {
    min-height: 400px;
    display: none; /* Default hidden, JavaScript will show the active one */
}

/* Force JavaScript display control */
.tab[style*="display: block"] {
    display: block !important;
    visibility: visible !important;
}

.tab[style*="display: none"] {
    display: none !important;
    visibility: hidden !important;
}
/* Improve form styling */
#serviceRequestForm {
    background: transparent;
}

/* Ensure navigation buttons are visible and clickable */
#prevBtn, #nextBtn {
    display: inline-block !important;
    cursor: pointer;
    z-index: 1000;
}

#prevBtn[style*="display: none"] {
    display: none !important;
}
</style>
<section class="<%=bg%> post-request-section mb-0 pb-4">
    <div class="container ">
        <form id="serviceRequestForm" novalidate>
            <div class="tab">
                <div class="tab-pane" id="request-desc">
                    <div class="card-header border-bottom mt-4 p-4 d-flex d-md-none">
                        <ul class="nav nav-gap-x-1" role="tablist">
                            <li class="nav-item">
                                <h6 class="numbering">1</h6><h6 class=" d-inline nav-link has-icon"><%= t('BriefDescription') %> </h6>
                            </li>
                            <li class="nav-item">
                                <svg width="8" height="16" viewBox="0 0 8 16" xmlns="http://www.w3.org/2000/svg"><path d="M0.772126 1.19065L0.153407 1.80934C0.00696973 1.95578 0.00696973 2.19322 0.153407 2.33969L5.80025 8L0.153407 13.6603C0.00696973 13.8067 0.00696973 14.0442 0.153407 14.1907L0.772126 14.8094C0.918563 14.9558 1.156 14.9558 1.30247 14.8094L7.84666 8.26519C7.99309 8.11875 7.99309 7.88131 7.84666 7.73484L1.30247 1.19065C1.156 1.04419 0.918563 1.04419 0.772126 1.19065Z"></path></svg>
                            </li>
                            <li class="nav-item ml-3">
                                <h6 class="numbering">2</h6><h6 class=" d-inline nav-link has-icon"><%= t('Timeline') %> </h6>
                            </li>
                        </ul>
                    </div>

                    <div class="row-service ">
                        <div class="col-md-6 col-sm-12 col-12 mb-3">
                            <h3><%= t('LetMatchingBegin') %></h3>
                            <h6 class="text-light mt-2"><%= t('ProvideProjectDescription') %></h6>
                            <img src="images/service_req.png" class="service-image"
                                alt="image">
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12 col-with-input">
                            <input type="hidden" name="username" id="username" value="<%= usr.username %>" class="input-field-input" oninput="this.className = 'input-field-input'">

                            <h6 class="mt-4 mb-1"><%= t('GiveProjectTitle') %></h6> 
                            <span><%= t('KeepTitleShortAndSimple') %> </span> <span class="text-light small text-muted" id="titleChars">  0/60</span> 
                                <input type="text" onkeyup="countTitleChars()" id="requestTitle" name="requestTitle" class="input-field-input" oninput="this.className = 'input-field-input'"
                                    placeholder="<%= t('ExampleProjectTitle') %>" maxlength="60">
                                
                    

                            <h6 class="mt-4 mb-1"><%= t('WhatLookingToDo') %></h6>
                            <span><%= t('HelpMatchRightTalent') %> <b><%= t('EnterAtLeast20Chars') %></b> </span> 
                            <div class="input-field">
                                <textarea type="text" id="requestDescription" class="input-field-textarea" onkeyup="countChars()" name="requestDescription" oninput="this.className = 'input-field-textarea'"
                                    placeholder="<%= t('INeedPlaceholder') %>"  maxlength="2000" minlength="20"></textarea>
                                <span class="char-limit" id="charCount">0/2,000</span> 
                            </div>
                            <span class="" id="attach_err_msg"></span>
                            <label for="pr-attachment" class="attach-btn">
                                <i class="fas fa-paperclip"></i> <%= t('AttachRequirementDoc') %>
                            </label>
                            <input id="pr-attachment" name="file" type="file"  accept=
                            "application/msword, application/vnd.ms-excel, application/vnd.ms-powerpoint,
                            text/plain, application/pdf, image/*" style="display: none;" >
                            <pre class="output"><%= t('SelectedFile') %>:</pre>
                            <h6 class="mt-4 mb-2"><%= t('WhichCategoryFitsProject') %></h6>
                                
                                <input type="text" class="form-control" id="requestCategory" name="requestCategory" oninput="this.className = 'form-control'" placeholder="<%= t('Category') %>"/>
                            </div>
                        </div>
                </div>
            </div>
            <div class="tab">
                <div class="tab-pane" id="requet-desc">
                    <div class="card-header border-bottom mt-4 p-4 d-flex d-md-none">
                        <ul class="nav nav-gap-x-1" role="tablist">
                            <li class="nav-item">
                                <b class="numbering fa fa-check" aria-hidden="true"></b><h6 class=" d-inline nav-link has-icon"><%= t('BriefDescription') %> </h6>
                            </li>
                            <li class="nav-item">
                                <svg width="8" height="16" viewBox="0 0 8 16" xmlns="http://www.w3.org/2000/svg"><path d="M0.772126 1.19065L0.153407 1.80934C0.00696973 1.95578 0.00696973 2.19322 0.153407 2.33969L5.80025 8L0.153407 13.6603C0.00696973 13.8067 0.00696973 14.0442 0.153407 14.1907L0.772126 14.8094C0.918563 14.9558 1.156 14.9558 1.30247 14.8094L7.84666 8.26519C7.99309 8.11875 7.99309 7.88131 7.84666 7.73484L1.30247 1.19065C1.156 1.04419 0.918563 1.04419 0.772126 1.19065Z"></path></svg>
                            </li>
                            <li class="nav-item ml-3">
                                <h6 class="numbering">2</h6><h6 class=" d-inline nav-link has-icon"><%= t('Timeline') %> </h6>
                            </li>
                        </ul>
                    </div>
                    <div class="row-service ">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12 mb-3">
                            <h3><%= t('TellUsHowSoonProject') %></h3>
                            <h6 class="text-light mt-2 pr-4"><%= t('GiveApproximateDeadline') %></h6>
                            <img src="/images/deadline.png" class="service-image"
                                alt="image">
                        </div>

                        <div class="col-lg-6 col-md-6 col-sm-12 col-12 col-with-input">
                            <span class="" id="err_msg"></span>
                            <h6 class="mb-2"><%= t('BudgetIHaveForThis') %> </h6> 
                            <span><%= t('EnterAmountToSpend') %> <b><%= t('EnterAtLeast') %> 1 <%=usr.currency_symbol%>.</b> </span>
                            
                                <div class="row">
                                    
                                    <div class="col-lg-4 col-md-4 col-12">
                                    <div class="form-group">
                                        <input type="number" step=".01" min="1" oninput="validity.valid||(value='');" placeholder="<%= t('Amount') %>" id="requestBudget" class="form-control" name="requestBudget" oninput="this.className = 'input-field-input'">
                                    </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <select name="budgetCurrency" id="budgetCurrency" class="form-control" >
                                                <option value="<%=usr.currency%>"> <%=usr.currency%></option>
                                                <% if(usr.currency != 'XAF') { %> <option value="XAF"> FCFA</option> <% } %>
                                                <% if(usr.currency != 'USD') { %> <option value="USD"> USD </option> <% } %>
                                                <% if(usr.currency != 'EUR') { %> <option value="XAF"> EUR </option> <% } %>
                                                <% if(usr.currency != 'GBP') { %> <option value="GBP"> GBP </option> <% } %>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <select name="budgetType" id="budgetType" class="form-control" >
                                                <option value="Per project"> <%= t('PerProject') %></option>
                                                <option value="Per hour"> <%= t('PerHour') %></option>
                                                
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <h6 class="mt-3 mb-2"><%= t('INeedItDoneBy') %> </h6> 
                                <span><%= t('EnterDeadlineForTask') %> <b><%= t('GiveAtLeastOneDay') %></b> </span>
                                <div class="form-group mb-4">
                                    <div class="datepicker date input-group p-0 shadow-sm" >
                                        <input placeholder="<%= t('SelectDate') %>" id="datepicker" name="requestDeadline" oninput="this.className = ' '">
                                        <!--div class="input-group-append"><span class="input-group-text px-4"><b class="fas fa-calendar"></b></span></div-->
                    
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab">
                <div class="tab-pane" id="requet-desc">
                    <div class="card-header border-bottom mt-4 p-4 d-flex d-md-none">
                        <ul class="nav nav-gap-x-1" role="tablist">
                            <li class="nav-item">
                                <b class="numbering fa fa-check" aria-hidden="true"></b><h6 class=" d-inline nav-link has-icon"><%= t('BriefDescription') %> </h6>
                            </li>
                            <li class="nav-item">
                                <svg width="8" height="16" viewBox="0 0 8 16" xmlns="http://www.w3.org/2000/svg"><path d="M0.772126 1.19065L0.153407 1.80934C0.00696973 1.95578 0.00696973 2.19322 0.153407 2.33969L5.80025 8L0.153407 13.6603C0.00696973 13.8067 0.00696973 14.0442 0.153407 14.1907L0.772126 14.8094C0.918563 14.9558 1.156 14.9558 1.30247 14.8094L7.84666 8.26519C7.99309 8.11875 7.99309 7.88131 7.84666 7.73484L1.30247 1.19065C1.156 1.04419 0.918563 1.04419 0.772126 1.19065Z"></path></svg>
                            </li>
                            <li class="nav-item ml-3">
                                <b class="numbering fa fa-check" aria-hidden="true"></b><h6 class=" d-inline nav-link has-icon"><%= t('Timeline') %> </h6>
                            </li>
                        </ul>
                    </div>
                    <div class="row-service">
                        <div class="col mt-2 mb-3" >
                            <div class="d-flex flex-column justify-content-center align-items-center">
                                <h3 class="mx-auto"><%= t('ServiceRequestSubmittedSuccess') %></h3>
                                <img  src="/images/done.png" class="service-image p-4 mx-auto"
                                    alt="image">
                                <h6 class="text-light mt-2 pr-4 mt-4 mx-auto"><%= t('ServiceRequestSubmittedInfo') %></h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr>
            <div class="d-flex justify-content-end mb-3">
                <p></p>
                <button type="button" class="button button-primary mr-4"  id="prevBtn" onclick="nextPrev(-1)"><%= t('Previous') %></button>
                <button type="button" class="button button-primary ml-4"  id="nextBtn" onclick="nextPrev(1)"><%= t('Next') %></button>
            </div>
        </form>
            
    </div>
</section>

<%- include('partials/footer') %>

<!-- Service Request Form Scripts -->
<script src="https://unpkg.com/gijgo@1.9.14/js/gijgo.min.js" type="text/javascript"></script>
<script>
$(document).ready(function() {
    console.log('Document ready, initializing service request form...');
    
    // Initialize datepicker
    var date = new Date();
    var minD = new Date(date.getFullYear(), date.getMonth(), date.getDate()+1, 0, 0, 0, 0);
    $('#datepicker').datepicker({ 
        minDate: minD,
        uiLibrary: 'bootstrap4'
    }); 

    // File input handler
    const output = document.querySelector(".output");
    const fileInput = document.querySelector("#pr-attachment");
    const attach_err_msg = document.getElementById("attach_err_msg");
    if(fileInput){
        fileInput.addEventListener("change", async () => {
            if(fileInput.files.length > 0){
                const fileSize = fileInput.files[0].size;
                const fileSizeInMB = fileSize / (1024*1024);
                if(fileSizeInMB > 10){
                    attach_err_msg.classList.add("error_message");
                    attach_err_msg.innerHTML = "<%= t('FileSizeTooLarge') %>";
                    await new Promise(r => setTimeout(r, 3500));
                    attach_err_msg.innerHTML = "";
                    return;
                }
            }
            for (const file of fileInput.files) {
                output.innerText += `\n${file.name}`; 
            }
        });
    }

    // Form navigation variables
    var currentTab = 0;

    // Form navigation functions
    window.showTab = function(n) {
        console.log('showTab called with n =', n);
        var x = document.getElementsByClassName("tab");
        console.log('Found', x.length, 'tabs');
        
        if (x.length === 0) {
            console.error('No tabs found!');
            return;
        }
        
        // Hide all tabs first with explicit logging
        for (var i = 0; i < x.length; i++) {
            x[i].style.display = "none";
            x[i].style.visibility = "hidden";
            console.log('Hiding tab', i);
        }
        
        // Show the current tab
        if (x[n]) {
            x[n].style.display = "block";
            x[n].style.visibility = "visible";
            console.log('Showing tab', n, '- display:', x[n].style.display);
        } else {
            console.error('Tab', n, 'not found');
            return;
        }
        
        // Get button elements
        var prevBtn = document.getElementById("prevBtn");
        var nextBtn = document.getElementById("nextBtn");
        
        if (!prevBtn || !nextBtn) {
            console.error('Navigation buttons not found');
            return;
        }
        
        // Handle Previous/Next buttons
        if (n == 0) {
            prevBtn.style.display = "none";
            console.log('Hiding previous button (first tab)');
        } else {
            prevBtn.style.display = "inline";
            console.log('Showing previous button');
        }
        
        if (n == (x.length - 2)) {
            nextBtn.innerHTML = "<%= t('Submit') %>";
            console.log('Setting next button to Submit');
        } else if(n == (x.length - 1)){
            prevBtn.style.display = "none";
            nextBtn.innerHTML = "<%= t('StartNewRequest') %>";
            console.log('Final tab - hiding prev, showing start new request');
        }
        else {
            nextBtn.innerHTML = "<%= t('Next') %>";
            console.log('Setting next button to Next');
        }
    };

    window.nextPrev = async function(n) {
        console.log('nextPrev called with n =', n, ', currentTab =', currentTab);
        
        try {
            var x = document.getElementsByClassName("tab");
            
            if (x.length === 0) {
                console.error('No tabs found in nextPrev!');
                return false;
            }
            
            // Validate form if going forward
            if (n == 1 && !validateForm()) {
                console.log('Form validation failed');
                return false;
            }
            
            // Handle submission logic
            if ((currentTab+n) == x.length-1) {
                const requestDeadline = document.getElementById("datepicker").value;
                const currentDate = new Date();
                const dateArr = currentDate.toLocaleDateString("en-US").split("/");
                const rqDateArr= requestDeadline.split("/");
                const reqDate = new Date(rqDateArr[2], rqDateArr[0], rqDateArr[1], 0, 0, 0, 0);
                const err_msg = document.getElementById("err_msg");
                if(reqDate < currentDate || rqDateArr.length < 2){
                    err_msg.classList.add("error_message");
                    err_msg.innerHTML = "<%= t('InvalidDeadlineMessage') %>";
                    await new Promise(r => setTimeout(r, 2500));
                    err_msg.innerHTML = "";
                    return  false;
                }
                else
                    onSubmit();
            }

            // Hide current tab and move to next
            if (x[currentTab]) {
                x[currentTab].style.display = "none";
                console.log('Hiding current tab', currentTab);
            }
            
            currentTab = currentTab + n;
            console.log('New currentTab =', currentTab);
            
            // Check bounds
            if (currentTab > x.length-1) {
                console.log('Reached end of form, reloading');
                window.location.reload();
                return;
            }
            
            if (currentTab < 0) {
                currentTab = 0;
                console.log('Corrected currentTab to 0');
            }
            
            // Show new tab
            showTab(currentTab);
            
        } catch (error) {
            console.error('Error in nextPrev function:', error);
            return false;
        }
    };

    // Form validation function
    function validateForm() {
        var x, y, z, valid = true;
        x = document.getElementsByClassName("tab");
        y = x[currentTab].getElementsByTagName("input");
        
        // Check all input fields in current tab
        for (var i = 0; i < y.length; i++) {
            if (y[i].value.trim() == "" && y[i].name != "file") {
                y[i].className += " invalid";
                valid = false;
            }
        }
        
        // Check description
        z = document.getElementById("requestDescription");
        if (z && (z.value.trim() == "" || z.value.length < 20)){
            z.className += " invalid";
            valid = false;
        }

        // Check category selection
        var category = document.getElementById("requestCategory");
        var categoryValue = category ? (category.getAttribute('data-value') || category.value) : '';
        if(category && (!categoryValue || categoryValue.trim() === '')){
            category.classList.add("invalid");
            valid = false;
        }
        
        return valid;
    }

    // Character counting functions
    window.countChars = function(){
        const desc = document.getElementById("requestDescription");
        const charCount = document.getElementById("charCount");
        if (desc && charCount) {
            charCount.innerHTML = desc.value.length+"/2,000";
        }
    };

    window.countTitleChars = function(){
        const title = document.getElementById("requestTitle");
        const charCount = document.getElementById("titleChars");
        if (title && charCount) {
            charCount.innerHTML = title.value.length+"/60";
        }
    };

    // Form submission function
    async function onSubmit() {
        const requestTitle = document.getElementById("requestTitle").value;
        const requestDescription = document.getElementById("requestDescription").value;
        const requestCategory = document.getElementById("requestCategory").getAttribute('data-value') || document.getElementById("requestCategory").value;
        const file = document.querySelector("#pr-attachment").files.item(0);
        const username = document.getElementById("username").value;
        const requestDeadline = document.getElementById("datepicker").value;
        const requestBudget = document.getElementById("requestBudget").value;
        const requestBudgetType = document.getElementById("budgetType").value;
        const budgetCurrency = document.getElementById("budgetCurrency").value;
        
        const formData = new FormData();
        formData.append("requestTitle", requestTitle);
        formData.append("requestDescription", requestDescription);
        formData.append("requestCategory", requestCategory);
        formData.append("file", file);
        formData.append("username", username);
        formData.append("requestDeadline", requestDeadline);
        formData.append("requestBudget", requestBudget);
        formData.append("requestBudgetType", requestBudgetType);
        formData.append("budgetCurrency", budgetCurrency);

        try {
            const response = await fetch("/postServiceRequest", {
                method: "POST",
                body: formData,
            });
            
            if (!response.ok) {
                throw new Error("Network response was not ok");
            }
            
            const data = await response.json();
            console.log("Form submitted successfully", data);
            
        } catch (error) {
            console.error("Form submission error:", error);
        }
    }

    // Debug function to check tab states
    window.debugTabStates = function() {
        console.log('=== TAB STATE DEBUG ===');
        var tabs = document.getElementsByClassName("tab");
        for (var i = 0; i < tabs.length; i++) {
            console.log('Tab', i, ':', {
                display: tabs[i].style.display,
                visibility: tabs[i].style.visibility,
                computed: window.getComputedStyle(tabs[i]).display
            });
        }
        console.log('Current active tab:', currentTab);
    };

    // Initialize the form
    showTab(currentTab);
    
    // Check initial state
    setTimeout(function() {
        console.log('Checking initial tab states after showTab...');
        window.debugTabStates();
    }, 100);
    
    console.log('Service request form initialization complete');
    
    // Initialize autocomplete for category input
    if (typeof AutoComplete !== 'undefined') {
        const categoryInput = document.getElementById('requestCategory');
        if (categoryInput) {
            new AutoComplete({
                inputId: 'requestCategory',
                apiUrl: '/api/search/categories',
                minLength: 1,
                placeholder: `<%= t('Category') %>`,
                noResultsText: '<%= t("NoCategories") || "No categories found" %>',
                debounceDelay: 300
            });
        }
    }
});
</script>

