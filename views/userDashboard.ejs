

<%- include('partials/header') %>
<%
    let totalProjects = 0;
    let totalBudget = 0.0;
    let activeProjects = 0;
    let completedProjects = 0;

    if (postRequests) { postRequests.forEach(request=>{
        if(request.status == "active" || request.status == "pending" || request.status == "in-progress" || request.status == "booked")
            activeProjects++;
        if(request.status == "completed" || request.status == "accepted" || request.status == "accepted & rated")
            completedProjects++;
        totalBudget += request.budget;
    });}
    totalProjects = activeProjects + completedProjects;
%>
<section class="section <%=bg%> search-pro-section">
<div class="container pad-4">

    <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4">
        <div class="col">
        <div class="card radius-10 border-start border-0 border-3 border-info">
        <a href="#"><div class="card-body">
            <div class="d-flex align-items-center">
                <div>
                <p class="mb-0 job-details"><%= t('TotalProjects') %></p>
                <% if(totalProjects <= 100000) { %> 
                    <h4 class="my-1 text-info"><%= totalProjects %></h4>
                <% } else if(totalProjects > 100000  && totalProjects < 1000000) {
                    totalProjects /= 1000; %>
                    <h4 class="my-1 text-info"><%= totalProjects %> K</h4>
                <% } else if(totalProjects >= 1000000  && totalProjects < 1000000000) { 
                    totalProjects /= 1000000; %>
                    <h4 class="my-1 text-info"><%= totalProjects %> M</h4>
                <% } else { 
                    totalProjects /= 1000000000; %>
                    <h4 class="my-1 text-info"><%= totalProjects %> B</h4>
                <% } %>
                <p class="mb-0 font-13"><%= t('TotalNumberOfProjects') %></p>
                </div>
        <div class="widgets-icons-2 rounded-circle bg-gradient-scooter text-white ms-auto"><b class="fa fa-shopping-cart"></b>
        </div>
        </div>
        </div></a>
        </div>
        </div>
        <div class="col">
        <div class="card radius-10 border-start border-0 border-3 border-danger">
        <a href="#"><div class="card-body">
        <div class="d-flex align-items-center">
        <div>
        <p class="mb-0 job-details"><%= t('TotalBudget') %></p>
        <% if(totalBudget <= 100000) { %> 
            <h4 class="my-1 text-danger"><%= parseFloat(totalBudget).toFixed(2) %></h4>
        <% } else if(totalBudget > 100000  && totalBudget < 1000000) {
            totalBudget /= 1000; %>
            <h4 class="my-1 text-danger"><%= parseFloat(totalBudget).toFixed(2) %> K</h4>
        <% } else if(totalBudget >= 1000000  && totalBudget < 1000000000) { 
            totalBudget /= 1000000; %>
            <h4 class="my-1 text-danger"><%= parseFloat(totalBudget).toFixed(2) %> M</h4>
        <% } else { 
            totalBudget /= 1000000000; %>
            <h4 class="my-1 text-danger"><%= parseFloat(totalBudget).toFixed(2) %> B</h4>
        <% } %>
        <p class="mb-0 font-13"><%= t('TotalSpendingForProjects') %></p>
        </div>
        <div class="widgets-icons-2 rounded-circle bg-gradient-bloody text-white ms-auto"><b class=""><%=usr.currency_symbol%></b>
        </div>
        </div>
        </div></a>
        </div>
        </div>
        <div class="col">
        <div class="card radius-10 border-start border-0 border-3 border-success">
        <a href="#"><div class="card-body">
        <div class="d-flex align-items-center">
        <div>
        <p class="mb-0 job-details"><%= t('RequestedServices') %></p>
        <% if(activeProjects <= 100000) { %> 
            <h4 class="my-1 text-success"><%= activeProjects %></h4>
        <% } else if(activeProjects > 100000  && activeProjects < 1000000) {
            activeProjects /= 1000; %>
            <h4 class="my-1 text-success"><%= activeProjects %> K</h4>
        <% } else if(activeProjects >= 1000000  && activeProjects < 1000000000) { 
            activeProjects /= 1000000; %>
            <h4 class="my-1 text-success"><%= activeProjects %> M</h4>
        <% } else { 
            activeProjects /= 1000000000; %>
            <h4 class="my-1 text-success"><%= activeProjects %> B</h4>
        <% } %>
        <p class="mb-0 font-13"><%= t('AllRequestedServices') %></p>
        </div>
        <div class="widgets-icons-2 rounded-circle bg-gradient-ohhappiness text-white ms-auto"><b class="fa fa-bar-chart"></b>
        </div>
        </div>
        </div></a>
        </div>
        </div>
        <div class="col">
        <div class="card radius-10 border-start border-0 border-3 border-warning">
        <a href="#"><div class="card-body">
        <div class="d-flex align-items-center">
        <div>
        <p class="mb-0 job-details"><%= t('CompletedProjects') %></p>
        <% if(completedProjects <= 100000) { %> 
            <h4 class="my-1 text-warning"><%= completedProjects %></h4>
        <% } else if(completedProjects > 100000  && completedProjects< 1000000) {
            completedProjects /= 1000; %>
            <h4 class="my-1 text-danger"><%= completedProjects %> K</h4>
        <% } else if(completedProjects >= 1000000  && completedProjects< 1000000000) { 
            completedProjects /= 1000000; %>
            <h4 class="my-1 text-danger"><%= completedProjects %> M</h4>
        <% } else { 
            completedProjects /= 1000000000; %>
            <h4 class="my-1 text-danger"><%= completedProjects %> B</h4>
        <% } %>
        <p class="mb-0 font-13"><%= t('AllCompletedProjects') %></p>
        </div>
        <div class="widgets-icons-2 rounded-circle bg-gradient-blooker text-white ms-auto"><b class="fa fa-users"></b>
        </div>
        </div>
        </div></a>
        </div>
        </div>
        </div>
        </div>
</div>

</section>
<% if(usr){ if(usr.favoriteProviders.length > 0) { %> 
    <%- include('partials/actualUserFavProviders') %>
<% } else { %>
    <%- include('partials/userFavPros') %>
<% } }%>


<section class="<%=bg %>" >
    <div class="container p-4">
        <div class="card-box card-u-pro-set">
            <div class="row">
                <div class="col-md-6 col-lg-6"><h4 class="header-title  text-light ml-3"><%= t('MyRequests') %></h4></div>
                <div class="col-md-6 col-lg-6 d-flex justify-content-end"><a href="/service-request"><button type="button" class="simple-btn" ><%= t('SubmitARequest') %></button></a>
            </div>
            
            <div class="table-responsive mt-3" style="max-height: 25em;">
                <table class="table table-hover">
                    <thead style="top: 0; position:sticky; background: white;">
                        <tr class="text-primary card-header medium">
                        <th>#</th>
                        <th><%= t('ProjectTitle') %></th>
                        <th class="sm-scr"><%= t('DatePosted') %></th>
                        <th class="sm-scr"><%= t('DueDate') %></th>
                        <th><%= t('Status') %></th>
                        <th class="sm-scr"><%= t('ServiceProvider') %></th>
                        </tr>
                    </thead>
                    <tbody>
                    <% let i = 1;
                        if (postRequests) { postRequests.forEach(request=>{ 
                            if(request.status != "cancelled"){
                                let status = request.status;
                                let backgd = "badge-green";
                                if(request.status == "active" || request.status == "pending"){
                                    status = lang === "fr" ? "Publiée" : "Pending";
                                    backgd = "badge-dark";
                                }else if(request.status == "booked"){
                                    status = lang === "fr" ? "Réservée" : "Booked";
                                    backgd = "badge-blue";
                                }
                                else if(request.status == "in-progress"){
                                    status = lang === "fr" ? "En cours" : "In Progress ";
                                    backgd = "badge-yellow";
                                }
                                else if(request.status == "accepted & rated"){
                                    status = lang === "fr" ? "Acceptée et evaluée" : "Accepted & Rated";
                                    backgd = "badge-green";
                                }
                                else if(request.status == "completed"){
                                    status = lang === "fr" ? "Terminée" : "Completed";
                                    backgd = "badge-green";
                                }
                                else if(request.status == "accepted"){
                                    status = lang === "fr" ? "Acceptée" : "Accepted";
                                    backgd = "badge-green";
                                }
                                else if(request.status == "cancelled"){
                                    status = lang === "fr" ? "Annulée" : "Cancelled";
                                    backgd = "badge-danger";
                                }
                            
                            %>
                        <tr id="project_row" class=" job-details cursor" onclick='window.location="/manage-request?rq=<%=request._id%>"'>
                        <td><%= i %></td>
                        <td><a href="#requestModalCta<%=i%>" data-toggle="modal" data-caption-animate="fadeInUp" ><%=request.requestTitle %></a></td>
                        <td class="sm-scr"><%=request.createdAt.getUTCMonth() + 1 %>/<%= request.createdAt.getUTCDate()%>/<%= request.createdAt.getUTCFullYear() %></td>
                        <td class="sm-scr"><%=request.deadline %></td>
                        <td><span class="badge <%=backgd%> text-white"><%=status%></span></td>
                        <td class="sm-scr"> <%= request.pro %></td>
                        </tr>

                    <% i++; } });} %>
                    
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>




