// Load payment methods on page load
loadUserEditPaymentMethods();

async function loadUserEditPaymentMethods(isRetry = false) {
    const container = document.getElementById('userEditPaymentMethods');

    if (!isRetry) {
        container.innerHTML = `
            <div class="payment-methods-skeleton px-3">
                ${[1, 2].map(() => `
                    <div class="list-group-item mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div style="flex: 1;">
                                <div class="skeleton-line" style="width: 200px; height: 18px; margin-bottom: 8px;"></div>
                                <div class="skeleton-line" style="width: 120px; height: 14px;"></div>
                            </div>
                            <div class="skeleton-line" style="width: 80px; height: 32px;"></div>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;
    }

    try {
        const response = await fetch('/payment-methods', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const data = await response.json();

        if (data.success && data.paymentMethods) {
            const methods = data.paymentMethods;

            if (methods.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4 px-3">
                        <b class="fa fa-credit-card fa-3x text-muted mb-3"></b>
                        <p class="text-muted"><%= t('NoPaymentMethodsYet') %></p>
                        <p class="small text-muted"><%= t('AddPaymentMethodToGetStarted') %></p>
                    </div>
                `;
                return;
            }

            let html = '<div class="list-group px-3">';

            methods.forEach(method => {
                const isExpired = method.isExpired;
                const expiryClass = isExpired ? 'text-danger' : 'text-muted';
                const defaultBadge = method.isDefault ? '<span class="badge badge-success ml-2"><%= t("Default") %></span>' : '';
                const expiredBadge = isExpired ? '<span class="badge badge-danger ml-2"><%= t("Expired") %></span>' : '';

                let cardIcon = 'fa-credit-card';
                if (method.cardBrand) {
                    const brand = method.cardBrand.toLowerCase();
                    if (brand === 'visa') cardIcon = 'fa-cc-visa';
                    else if (brand === 'mastercard') cardIcon = 'fa-cc-mastercard';
                    else if (brand === 'amex') cardIcon = 'fa-cc-amex';
                    else if (brand === 'discover') cardIcon = 'fa-cc-discover';
                }

                const providerIcon = method.provider === 'paypal' ? 'fa-cc-paypal' : cardIcon;

                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center" style="flex: 1;">
                            <b class="fa ${providerIcon} fa-2x text-primary mr-3"></b>
                            <div>
                                <div class="font-weight-bold">
                                    ${method.displayName}
                                    ${defaultBadge}
                                    ${expiredBadge}
                                </div>
                                <div class="small ${expiryClass}">
                                    ${method.type === 'card' && method.cardExpiryMonth && method.cardExpiryYear
                                        ? '<%= t("Expires") %>: ' + String(method.cardExpiryMonth).padStart(2, '0') + '/' + method.cardExpiryYear
                                        : '<%= t("Added") %>: ' + new Date(method.createdAt).toLocaleDateString()
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="btn-group">
                            
                            <button class="btn btn-sm btn-outline-danger" onclick="deletePaymentMethod('${method.id}')">
                                <b class="fa fa-trash"></b>
                            </button>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        } else {
            throw new Error(data.message || 'Failed to load payment methods');
        }
    } catch (error) {
        console.error('Error loading payment methods:', error);
        container.innerHTML = `
            <div class="alert alert-danger mx-3">
                <b class="fa fa-exclamation-circle"></b> <%= t('ErrorLoadingPaymentMethods') %>
                <button class="btn btn-sm btn-link" onclick="loadUserEditPaymentMethods(true)"><%= t('TryAgain') %></button>
            </div>
        `;
    }
}

async function setDefaultPaymentMethod(methodId) {
    try {
        const response = await fetch(`/set-default-payment-method/${methodId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const data = await response.json();

        if (data.success) {
            loadUserEditPaymentMethods(true);
        } else {
            alert(data.message || '<%= t("ErrorSettingDefaultPaymentMethod") %>');
        }
    } catch (error) {
        console.error('Error setting default payment method:', error);
        alert('<%= t("ErrorSettingDefaultPaymentMethod") %>');
    }
}

async function deletePaymentMethod(methodId) {
    if (!confirm('<%= t("ConfirmDeletePaymentMethod") %>')) {
        return;
    }

    try {
        const response = await fetch(`/delete-payment-method/${methodId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const data = await response.json();

        if (data.success) {
            loadUserEditPaymentMethods(true);
        } else {
            alert(data.message || '<%= t("ErrorDeletingPaymentMethod") %>');
        }
    } catch (error) {
        console.error('Error deleting payment method:', error);
        alert('<%= t("ErrorDeletingPaymentMethod") %>');
    }
}
  </script>


  <script src="js/userEdit.js"></script>


