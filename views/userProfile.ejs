<script>
// Load payment methods when billing tab is shown
async function loadUserPaymentMethods() {
    const container = document.getElementById('userProfilePaymentMethods');

    try {
        const response = await fetch('/api/payment/payment-methods');
        const data = await response.json();

        if (data.success && data.paymentMethods.length > 0) {
            let html = '<div class="list-group">';

            data.paymentMethods.forEach(method => {
                const icon = method.provider === 'stripe' ? 'fa-credit-card' : 'fa-paypal';
                const defaultBadge = method.isDefault
                    ? '<span class="badge badge-primary ml-2"><%= t("Default") %></span>'
                    : '';
                const expiredBadge = method.isExpired
                    ? '<span class="badge badge-danger ml-2"><%= t("Expired") %></span>'
                    : '';

                html += `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <b class="fa ${icon} mr-2"> </b>
                                <strong>${method.displayName}</strong>
                                ${defaultBadge}
                                ${expiredBadge}
                                ${method.lastUsedAt ? `<div class="small text-muted mt-1"><%= t("LastUsed") %>: ${new Date(method.lastUsedAt).toLocaleDateString()}</div>` : ''}
                            </div>
                            <div>
                                ${!method.isDefault ? `
                                    <button class="btn btn-sm btn-outline-primary mr-2" onclick="setDefaultPaymentMethod('${method.id}')">
                                        <%= t("SetAsDefault") %>
                                    </button>
                                ` : ''}
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteUserPaymentMethod('${method.id}')">
                                    <b class="fa fa-trash"> </b>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        } else {
            container.innerHTML = `
                <div class="alert alert-info text-center">
                    class="fa fa-info-circle"></b> <%= t('YouHaveNotAddedPaymentMethod') %>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading payment methods:', error);
        container.innerHTML = `
            <div class="alert alert-danger">
                class="fa fa-exclamation-triangle"></b> <%= t('ErrorLoadingPaymentMethods') %>
            </div>
        `;
    }
}

// Load payment history
async function loadPaymentHistory() {
    const container = document.getElementById('userProfilePaymentHistory');

    try {
        const response = await fetch('/api/payment/transactions?limit=10');
        const data = await response.json();

        if (data.success && data.transactions.length > 0) {
            let html = '<div class="table-responsive"><table class="table table-sm">';
            html += '<thead><tr><th><%= t("Date") %></th><th><%= t("Description") %></th><th><%= t("Amount") %></th><th><%= t("Status") %></th></tr></thead><tbody>';

            data.transactions.forEach(tx => {
                const statusBadge = {
                    'pending': 'badge-warning',
                    'held': 'badge-info',
                    'released': 'badge-success',
                    'refunded': 'badge-secondary',
                    'failed': 'badge-danger'
                }[tx.status] || 'badge-secondary';

                const statusText = {
                    'pending': '<%= t("Pending") %>',
                    'held': '<%= t("Held") %>',
                    'released': '<%= t("Released") %>',
                    'refunded': '<%= t("Refunded") %>',
                    'failed': '<%= t("Failed") %>'
                }[tx.status] || tx.status;

                html += `
                    <tr>
                        <td>${new Date(tx.createdAt).toLocaleDateString()}</td>
                        <td>${tx.description}</td>
                        <td>${tx.amount}</td>
                        <td><span class="badge ${statusBadge}">${statusText}</span></td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';

            if (data.totalPages > 1) {
                html += `<div class="text-center mt-3">
                    <small class="text-muted"><%= t("ShowingPage") %> ${data.currentPage} <%= t("of") %> ${data.totalPages}</small>
                </div>`;
            }

            container.innerHTML = html;
        } else {
            container.innerHTML = `
                <div class="alert alert-info text-center">
                    class="fa fa-info-circle"></b> <%= t('YouHaveNotMadeAnyPayment') %>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading payment history:', error);
        container.innerHTML = `
            <div class="alert alert-danger">
                class="fa fa-exclamation-triangle"></b> <%= t('ErrorLoadingPaymentHistory') %>
            </div>
        `;
    }
}

// Delete payment method
async function deleteUserPaymentMethod(paymentMethodId) {
    if (!confirm('<%= t("AreYouSureDeletePaymentMethod") %>')) {
        return;
    }

    try {
        const response = await fetch(`/api/payment/payment-method/${paymentMethodId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (data.success) {
            alert('<%= t("PaymentMethodDeleted") %>');
            await loadUserPaymentMethods();
        } else {
            throw new Error(data.error);
        }
    } catch (error) {
        alert('<%= t("ErrorDeletingPaymentMethod") %>: ' + error.message);
    }
}

// Load data when billing tab is clicked
$('a[href="#billing"]').on('shown.bs.tab', function() {
    loadUserPaymentMethods();
    loadPaymentHistory();
});

// Load immediately if billing tab is active
if (window.location.hash === '#billing' || $('a[href="#billing"]').hasClass('active')) {
    loadUserPaymentMethods();
    loadPaymentHistory();
}
